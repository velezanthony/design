---
import Link from '../../atoms/Link.astro';
import { INFO_HIDDEN_LABELS } from '../labels';

interface Props {
  /** La misma tabla con todas las gravedades, para ver también lo informativo. */
  showAllHref: string;
}

const { showAllHref } = Astro.props;
---

{/* Aviso de que la vista por defecto oculta algo: sin él, «75 de 151» parecería un fallo. */}
<p class="border border-rule bg-raised p-3 text-muted" data-info-hidden>
  {INFO_HIDDEN_LABELS.text} <Link href={showAllHref}>{INFO_HIDDEN_LABELS.showAll}</Link>
</p>
