---
import { clip } from '../../../core/seo-on-page/queries/clip';
import { PREVIEW_LABELS } from '../labels';

interface Props {
  /** El `<title>` tal como se publica. */
  title: string;
  /** URL absoluta de la página. */
  url: string;
  description?: string;
  /** Límites a partir de los cuales el buscador recorta (`THRESHOLDS`). */
  titleMax: number;
  descriptionMax: number;
}

const { title, url, description, titleMax, descriptionMax } = Astro.props;
---

<div class="max-w-measure-full border border-rule bg-canvas p-4" data-serp="card">
  <p class="truncate font-mono text-sm text-muted" data-serp="url">
    {url}
  </p>
  <p class="mt-1 text-xl text-accent" data-serp="title">
    {clip(title, titleMax)}
  </p>
  {description !== undefined ? (
    <p class="mt-1 text-ink" data-serp="description">
      {clip(description, descriptionMax)}
    </p>
  ) : (
    <p class="mt-1 text-muted italic" data-serp="description">
      {PREVIEW_LABELS.noDescription}
    </p>
  )}
</div>
