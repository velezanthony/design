---
import type { UiStrings } from '../../../core/i18n/ui-strings';
import Heading from '../../atoms/display/Heading.astro';
import Admonition from '../../molecules/content/Admonition.astro';
import { PANEL_LABELS } from '../labels';

interface Props {
  /** Nombre de la pantalla: es el `h1`. */
  title: string;
  /** Una frase bajo el título que dice qué hace la pantalla. */
  lede?: string;
  strings: UiStrings;
}

const { title, lede, strings } = Astro.props;
---

<div class="mb-6 flex flex-col gap-6">
  <Admonition kind="note" title={PANEL_LABELS.devOnly} strings={strings}>
    <p>{PANEL_LABELS.devOnlyBody}</p>
  </Admonition>
  <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
    <Heading level={1} size="xl">
      {title}
    </Heading>
    {Astro.slots.has('actions') && (
      <div data-intro-actions class="flex flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
    )}
  </div>
  {lede && <p class="max-w-measure text-muted">{lede}</p>}
</div>
