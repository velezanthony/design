---
/* La cabecera de la tabla: cuántas filas hay (dicho según la vista) y el selector de vista. */
import type { SeoView } from '../../../core/seo-on-page/queries/url-filters';
import { REPORT_LABELS } from '../../../core/seo-on-page/labels';
import ViewSwitch from './ViewSwitch.astro';

interface Props {
  /** El recuento ya redactado (`headCount`). */
  count: string;
  views: { view: SeoView; href: string; current: boolean }[];
  /** Ofrece copiar para la IA las páginas de la tabla («Qué tiene» filtrado por lo que falta). */
  copyReport?: boolean;
}

const { count, views, copyReport = false } = Astro.props;
---

<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
  <p class="text-muted" data-head-count>
    {count}
    {copyReport && (
      <>
        {' · '}
        <button
          type="button"
          hidden
          data-report-open="filter"
          class="cursor-pointer text-accent underline underline-offset-2 hover:text-ink"
        >
          {REPORT_LABELS.openLacks}
        </button>
      </>
    )}
  </p>
  <ViewSwitch views={views} />
</div>
