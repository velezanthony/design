---
import { PREVIEW_LABELS } from '../labels';

interface Props {
  title: string;
  description?: string;
  /** Dominio que enseña la tarjeta. */
  host: string;
  /** `src` ya resoluble por el navegador (con `base`), no el de la config. */
  image?: { src: string; alt: string; width?: number; height?: number };
}

const { title, description, host, image } = Astro.props;
---

<div class="max-w-measure border border-rule bg-canvas" data-og-card>
  {image ? (
    <img
      src={image.src}
      alt={image.alt}
      width={image.width}
      height={image.height}
      class="aspect-[1.91/1] w-full border-b border-rule bg-raised object-cover"
    />
  ) : (
    <div class="flex aspect-[1.91/1] items-center justify-center border-b border-rule bg-raised text-muted">
      {PREVIEW_LABELS.noImage}
    </div>
  )}
  <div class="p-3">
    <p class="label text-faint">{host}</p>
    <p class="mt-1 font-semibold text-ink">{title}</p>
    {description && <p class="mt-1 text-sm text-muted">{description}</p>}
  </div>
</div>
