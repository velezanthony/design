---
import { CLIENT_FAILURE_LABELS as labels } from '../../labels';
import PanelNotice from '../../molecules/PanelNotice.astro';

interface Props {
  /** Las páginas de `src/pages/` que no se pudieron leer, con el motivo tal como llegó. */
  failures: { entrypoint: string; message: string }[];
}

const { failures } = Astro.props;
---

{/* Sin pulir a propósito: basta con ver qué fichero falla y por qué para poder arreglarlo. */}
{failures.length > 0 && (
  <PanelNotice
    tone="danger"
    label={labels.region}
    title={labels.title(failures.length)}
    why={labels.why}
    data-client-failures
  >
    {failures.map(({ entrypoint, message }) => (
      <li>
        <code>{entrypoint}</code> — {message}
      </li>
    ))}
  </PanelNotice>
)}
