---
/* «Cobertura de idiomas»: cuántas páginas están en todos los idiomas y cuáles no. */
import Note from '../../atoms/Note.astro';
import type { OverviewModel } from '../../../../core/seo-on-page/pages/overview/model';
import Link from '../../../atoms/actions/Link.astro';
import Tag from '../../../atoms/display/Tag.astro';
import OverviewCard from '../../molecules/OverviewCard.astro';
import StateMark from '../../atoms/StateMark.astro';
import {
  CARD_LABELS,
  MATRIX_LABELS,
  slugLabel,
  TAG_HINTS,
  tagLabel,
} from '../../../../core/seo-on-page/labels';

interface Props {
  coverage: NonNullable<OverviewModel['coverage']>;
}

const { coverage } = Astro.props;
const labels = CARD_LABELS.coverage;
const completeShare = (coverage.complete / coverage.pages) * 100;
const cell = 'px-2 py-1.5 align-top';
const edge = 'border-b border-rule';
const restCount = coverage.complete;
---

<OverviewCard id="c-loc" title={labels.title} why={labels.why}>
  <div class="grid grid-cols-2 gap-4">
    <p class="flex flex-col" data-count="complete">
      <b class="text-display font-semibold text-ink">{coverage.complete}</b>
      <span class="text-sm text-muted">{labels.complete(coverage.locales.length)}</span>
    </p>
    <p class="flex flex-col" data-count="partial">
      <b class="text-display font-semibold text-ink">{coverage.partial}</b>
      <span class="text-sm text-muted">{labels.partial(coverage.locales.length)}</span>
    </p>
  </div>
  <div
    class="flex h-2 w-full overflow-hidden bg-state-wip"
    role="img"
    aria-label={labels.bar(coverage.complete, coverage.pages)}
  >
    <span class="bg-state-live" style={`width:${completeShare}%`}></span>
  </div>
  {coverage.partial > 0 && (
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left text-sm" data-incomplete>
        <caption class="sr-only">{labels.caption}</caption>
        <thead>
          <tr class="label text-muted">
            <th scope="col" class:list={[cell, edge]}>
              {MATRIX_LABELS.page}
            </th>
            {coverage.locales.map((locale) => (
              <th scope="col" class:list={[cell, edge]}>
                {locale.toUpperCase()}
              </th>
            ))}
            <th scope="col" class:list={[cell, edge]}>
              {MATRIX_LABELS.hreflang}
            </th>
          </tr>
        </thead>
        <tbody>
          {coverage.incomplete.map((row) => (
            <tr class={edge} data-page={row.slug}>
              <th scope="row" class:list={[cell, 'font-normal']}>
                <Link href={row.href} class="font-mono">
                  {slugLabel(row.slug)}
                </Link>
                {row.tags.map((tag) => (
                  <Tag bordered plain class="ml-1.5" title={TAG_HINTS[tag.kind]}>
                    {tagLabel(tag)}
                  </Tag>
                ))}
              </th>
              {row.cells.map(({ state }) => (
                <td class={cell}>
                  <StateMark {...MATRIX_LABELS.states[state]} />
                </td>
              ))}
              <td class={cell}>
                <StateMark {...MATRIX_LABELS.hreflangStates[row.hreflang]} />
              </td>
            </tr>
          ))}
          {restCount > 0 && (
            <tr class={edge} data-rest>
              <th scope="row" class:list={[cell, 'font-normal text-muted']}>
                {labels.more(restCount)}
              </th>
              <td class={cell} colspan={coverage.locales.length + 1}>
                <StateMark {...MATRIX_LABELS.states.exists} text={labels.allComplete} />
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  )}
  {coverage.moreIncomplete > 0 && (
    <p class="text-sm text-muted" data-more-incomplete>
      {labels.moreIncomplete(coverage.moreIncomplete)}
    </p>
  )}
  <Note data-note>
    {labels.note}
    {coverage.complete > 0 &&
      coverage.reciprocal === coverage.complete &&
      labels.reciprocal(coverage.complete)}
  </Note>
  <p class="text-sm">
    <Link href={coverage.href}>{labels.matrix}</Link>
  </p>
</OverviewCard>
