---
import type { InspectorModel } from '../../../../core/seo-on-page/pages/inspector/model';
import Tag from '../../../atoms/display/Tag.astro';
import { SCHEMA_LABELS as labels } from '../../labels';
import InspectorSection from '../../molecules/InspectorSection.astro';

interface Props {
  schemas: InspectorModel['schemas'];
}

const { schemas } = Astro.props;
---

<InspectorSection section="schemas">
  <div data-schemas class="flex flex-col gap-2">
    {schemas.length === 0 ? (
      <p class="text-muted">{labels.none}</p>
    ) : (
      schemas.map(({ types, source, json, pages }) => (
        <details data-schema class="border border-rule bg-raised">
          <summary class="flex cursor-pointer flex-wrap items-baseline gap-x-3 gap-y-1 p-3">
            <span class="font-mono text-ink">{types.join(', ')}</span>
            <Tag plain bordered data-source={source}>
              {source === 'site' ? labels.site : labels.page}
            </Tag>
            {pages !== undefined && <span class="text-sm text-muted">{labels.inPages(pages)}</span>}
          </summary>
          <pre
            class="overflow-x-auto border-t border-rule bg-canvas p-3 font-mono text-sm text-ink"
            set:text={json}
          />
        </details>
      ))
    )}
  </div>
</InspectorSection>
