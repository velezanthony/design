---
import type { PageRow } from '../../../../core/seo-on-page/pages/listing/rows';
import { THRESHOLDS } from '../../../../core/seo-on-page/thresholds';
import IssueBadge from '../../atoms/IssueBadge.astro';
import LengthMeter from '../../atoms/LengthMeter.astro';
import LocaleBadge from '../../atoms/LocaleBadge.astro';
import DataTable from '../../molecules/DataTable.astro';
import EmptyNotice from '../../molecules/EmptyNotice.astro';
import LocaleDetailCard from '../../molecules/LocaleDetailCard.astro';
import RowHeader from '../../molecules/RowHeader.astro';
import { PAGES_TABLE_LABELS, slugLabel } from '../../labels';
import { CELL, EDGE } from '../../tables';

interface Props {
  /** Una fila por página (slug), ya agrupada y ordenada por gravedad. */
  rows: PageRow[];
}

const { rows } = Astro.props;
---

{rows.length === 0 ? (
  <EmptyNotice />
) : (
  <DataTable
    caption={PAGES_TABLE_LABELS.caption}
    columns={[
      PAGES_TABLE_LABELS.page,
      PAGES_TABLE_LABELS.locales,
      '<title>',
      PAGES_TABLE_LABELS.issues,
    ]}
    cards
  >
    {rows.map((row) => (
      /* Un `<tbody>` por página: la fila y su detalle quedan juntos y el borde las separa de la siguiente. */
      <tbody class={EDGE} data-page={row.slug} data-card>
        <tr>
          <RowHeader slug={row.slug} href={row.href} tags={row.tags} tagsLayout="block">
            <p class="text-ink">{row.title}</p>
          </RowHeader>
          <td class={CELL} data-cell={PAGES_TABLE_LABELS.locales}>
            <div class="flex flex-wrap gap-1.5">
              {row.locales.map(({ locale, tone }) => (
                <LocaleBadge locale={locale} tone={tone} />
              ))}
            </div>
          </td>
          <td class={CELL} data-cell={'<title>'}>
            <LengthMeter
              value={row.titleLength}
              max={THRESHOLDS.titleMax}
              min={THRESHOLDS.titleMin}
            />
          </td>
          <td class={CELL} data-cell={PAGES_TABLE_LABELS.issues}>
            {row.issues.length === 0 ? (
              <span class="text-muted">{PAGES_TABLE_LABELS.noOwnIssues}</span>
            ) : (
              <ul class="flex flex-col gap-1.5">
                {row.issues.map(({ issue, locales }) => (
                  <li class="flex flex-wrap items-baseline gap-x-2">
                    <IssueBadge issue={issue} />
                    <span class="font-mono text-xs tracking-wide text-faint" data-where>
                      {locales.map((locale) => locale.toUpperCase()).join(' ')}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </td>
        </tr>
        <tr>
          <td colspan="4" class="px-3 pb-2">
            <details>
              <summary class="label min-h-6 cursor-pointer text-muted">
                {PAGES_TABLE_LABELS.detail}
                <span class="sr-only"> de {slugLabel(row.slug)}</span>
              </summary>
              <div class="mt-2 grid gap-3 sm:grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))]">
                {row.locales.map((detail) => (
                  <LocaleDetailCard detail={detail} />
                ))}
              </div>
            </details>
          </td>
        </tr>
      </tbody>
    ))}
  </DataTable>
)}
