---
/* Vista «Qué tiene»: una fila por página y una columna por cosa; cada cabecera alterna `lacks` en la URL. */
import Note from '../../atoms/Note.astro';
import type { ListingTable } from '../../../../core/seo-on-page/pages/listing/model';
import Link from '../../../atoms/actions/Link.astro';
import DataTable from '../../molecules/DataTable.astro';
import EmptyNotice from '../../molecules/EmptyNotice.astro';
import RowHeader from '../../molecules/RowHeader.astro';
import StateMark from '../../molecules/StateMark.astro';
import { HAVE_LABELS as LABELS, haveCellText } from '../../labels';
import { CELL, EDGE } from '../../tables';

type Have = Extract<ListingTable, { view: 'have' }>;

interface Props {
  rows: Have['rows'];
  columns: Have['columns'];
}

const { rows, columns } = Astro.props;
---

<div class="flex flex-col gap-3">
  <p class="text-sm text-muted">{LABELS.why}</p>
  <DataTable caption={LABELS.caption} columns={[LABELS.page]} headClass="align-bottom">
    <Fragment slot="head">
      {columns.map(({ column, href, pressed, good, total }) => (
        <th scope="col" class:list={[CELL, EDGE]}>
          <Link
            href={href}
            variant="quiet"
            aria-current={pressed ? 'true' : undefined}
            data-have-col={column}
            class:list={[
              'flex-col items-start gap-0.5',
              pressed && 'bg-accent-soft text-accent hover:text-accent',
            ]}
          >
            {LABELS.columns[column].name}
            <span class="text-xs font-semibold normal-case tracking-normal text-ink">
              {LABELS.count(column, good, total)}
            </span>
            {pressed && (
              <span class="text-[0.7rem] font-normal normal-case tracking-normal">
                {LABELS.pressed}
              </span>
            )}
          </Link>
        </th>
      ))}
    </Fragment>
    <tbody>
      {rows.map((row) => (
        <tr class={EDGE} data-page={row.slug}>
          <RowHeader slug={row.slug} href={row.href} tags={row.tags} />
          {columns.map(({ column }) => (
            <td class={CELL} data-col={column} data-state={row.cells[column].state}>
              <StateMark
                {...LABELS.states[row.cells[column].state]}
                text={haveCellText(column, row.cells[column])}
              />
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </DataTable>
  {rows.length === 0 && <EmptyNotice />}
  <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label={LABELS.legendLabel}>
    {LABELS.legend.map(({ state, text }) => (
      <li>
        <StateMark {...LABELS.states[state]} text={text} />
      </li>
    ))}
  </ul>
  <Note>{LABELS.note}</Note>
</div>
