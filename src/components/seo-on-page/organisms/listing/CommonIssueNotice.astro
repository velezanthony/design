---
import type { CommonIssue } from '../../../../core/seo-on-page/pages/listing/common';
import { plainText } from '../../../../core/seo-on-page/queries/code-spans';
import Link from '../../../atoms/actions/Link.astro';
import IssueBadge from '../../atoms/IssueBadge.astro';
import { COMMON_ISSUE_LABELS } from '../../../../core/seo-on-page/labels';

interface Props {
  issue: CommonIssue;
  /** Dónde se explica cómo arreglarlo para todo el sitio. */
  overviewHref: string;
}

const { issue, overviewHref } = Astro.props;
---

{/* Un tipo que afecta a TODAS las páginas filtradas no se repite en cada fila: se dice una vez aquí. */}
<aside
  class="notice-frame flex flex-wrap items-baseline gap-x-4 gap-y-2 border-rule"
  aria-label={COMMON_ISSUE_LABELS.region}
  data-common={issue.kind}
>
  <IssueBadge issue={{ kind: issue.kind, severity: issue.severity, message: '' }} />
  <p class="min-w-[16rem] flex-1">
    <strong class="font-semibold text-ink">
      {COMMON_ISSUE_LABELS.affects(issue.pages, issue.entries)}
    </strong>
    , {COMMON_ISSUE_LABELS.why}
    {issue.fix && ` ${plainText(issue.fix)}`}
  </p>
  <Link href={overviewHref}>{COMMON_ISSUE_LABELS.overview}</Link>
</aside>
