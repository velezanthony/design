---
import { GAP, pageWindow } from '../../core/navigation/page-window';
import Link from '../atoms/Link.astro';

interface Props {
  /** Página actual (ya acotada) y total de páginas. */
  page: number;
  pages: number;
  /** Enlace a una página; el que llama decide qué lleva (filtros, orden…). */
  href: (page: number) => string;
  /** Textos de la interfaz. Sin ellos, unos neutrales en inglés: el idioma lo pone quien la usa. */
  labels?: {
    /** Nombre accesible de la navegación. */
    nav: string;
    previous: string;
    next: string;
    /** Nombre accesible del enlace a una página concreta. */
    page: (number: number) => string;
  };
}

const NEUTRAL_LABELS = {
  nav: 'Pagination',
  previous: '← Previous',
  next: 'Next →',
  page: (number: number) => `Page ${number}`,
};

const { page, pages, href, labels = NEUTRAL_LABELS } = Astro.props;

/* Con 0 o 1 páginas el paginador se queda inerte como «página 1 de 1», para que la tabla no cambie de forma. */
const total = Math.max(pages, 1);
const current = Math.min(Math.max(page, 1), total);
const items = pageWindow(current, total);
const hasPrevious = current > 1;
const hasNext = current < total;
/* Todos los números comparten caja para que la fila no baile: 32px, por encima de los 24px de WCAG. */
const box = 'min-h-8 min-w-8 justify-center px-2';
/* Lo que no lleva a ningún sitio: no es un enlace (sin `href` no entra en el orden de tabulación),
   pero conserva el rol para que un lector de pantalla lo anuncie como no disponible. */
const disabled = `inline-flex items-center ${box} cursor-not-allowed text-muted opacity-60`;
---

{
  /* Enlaces de verdad: funciona sin JavaScript, con teclado y con atrás/adelante. */
  <nav aria-label={labels.nav}>
    <ul class="flex flex-wrap items-center gap-1">
      <li>
        {hasPrevious ? (
          <Link href={href(current - 1)} rel="prev" class={box}>
            {labels.previous}
          </Link>
        ) : (
          <span role="link" aria-disabled="true" class={disabled}>
            {labels.previous}
          </span>
        )}
      </li>
      {items.map((item) => (
        <li>
          {item === GAP ? (
            <span data-gap aria-hidden="true" class="px-1 text-muted">
              …
            </span>
          ) : item === current && total === 1 ? (
            /* Única página: no hay a dónde ir, así que ni siquiera es un enlace a sí misma. */
            <span
              data-page
              aria-current="page"
              class:list={[
                'inline-flex items-center border border-accent bg-accent-soft text-ink',
                box,
              ]}
            >
              {item}
            </span>
          ) : item === current ? (
            /* La actual es un enlace a sí misma (se ve y se anuncia como actual), en tinta y con caja. */
            <Link
              data-page
              href={href(item)}
              aria-current="page"
              variant="value"
              class:list={[box, 'border border-accent bg-accent-soft hover:text-ink']}
            >
              {item}
            </Link>
          ) : (
            <Link data-page href={href(item)} aria-label={labels.page(item)} class={box}>
              {item}
            </Link>
          )}
        </li>
      ))}
      <li>
        {hasNext ? (
          <Link href={href(current + 1)} rel="next" class={box}>
            {labels.next}
          </Link>
        ) : (
          <span role="link" aria-disabled="true" class={disabled}>
            {labels.next}
          </span>
        )}
      </li>
    </ul>
  </nav>
}
