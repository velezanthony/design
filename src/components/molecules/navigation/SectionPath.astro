---
import type { HTMLAttributes } from 'astro/types';

/* El camino de una página en la navegación, «Sección › Grupo», leído como una sola frase. Con el
   camino vacío no pinta nada. */
interface Props extends Omit<HTMLAttributes<'span'>, 'class'> {
  path: string[];
  class?: string;
}

const { path, class: className, ...rest } = Astro.props;
---

{path.length > 0 && (
  <span class={className} {...rest}>
    {path.join(' › ')}
  </span>
)}
