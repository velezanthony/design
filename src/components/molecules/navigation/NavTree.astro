---
import type { Locale } from '../../../core/i18n/locale';
import { localeNames, translate, type UiStrings } from '../../../core/i18n/ui-strings';
import { isNavTreeGroup, type NavTreeNode } from '../../../core/navigation/nav-tree';

/* El índice que genera `::nav-tree`: listas anidadas dentro de `.prose`, con la etiqueta de cada
   grupo en negrita y cada página como enlace seguido de su descripción. Es el mismo marcado que una
   lista escrita a mano en Markdown, así que toma el estilo de `.prose` tal cual. */
interface Props {
  nodes: NavTreeNode[];
  /** Con la descripción de cada página detrás de su título. */
  descriptions: boolean;
  strings: UiStrings;
  /** Interna: la lista de dentro de un grupo, sin la clase de la raíz. */
  nested?: boolean;
}

const { nodes, descriptions, strings, nested = false } = Astro.props;

function badgeName(locale: Locale) {
  return translate(strings, 'translation.badgeLabel', { locale: localeNames[locale] ?? locale });
}
---

{nodes.length > 0 && (
  <ul class:list={[!nested && 'docs-nav-tree']}>
    {nodes.map((node) => {
      const group = isNavTreeGroup(node);
      const link = node.href && (
        <a href={node.href} hreflang={node.badge} lang={node.badge}>
          {node.label}
          {node.badge && (
            <span
              role="img"
              aria-label={badgeName(node.badge)}
              class="label ml-2 border border-rule px-1 text-faint"
            >
              {node.badge}
            </span>
          )}
        </a>
      );
      return (
        <li>
          {group ? <strong>{link || node.label}</strong> : link}
          {descriptions && node.description && <Fragment> — {node.description}</Fragment>}
          {group && (
            <Astro.self nodes={node.items} descriptions={descriptions} strings={strings} nested />
          )}
        </li>
      );
    })}
  </ul>
)}
