---
import type { Locale } from '../../../core/i18n/locale';
import { localeNames, translate, type UiStrings } from '../../../core/i18n/ui-strings';
import Tag from '../../atoms/display/Tag.astro';

/* El enlace a una página desde un listado o desde `::nav-tree`: su título y, si lleva al original de
   otro idioma (política `link`), la insignia de ese idioma con el átomo `Tag`, como en la barra
   lateral. */
interface Props {
  href: string;
  title: string;
  badge?: Locale;
  strings: UiStrings;
  class?: string;
}

const { href, title, badge, strings, class: className } = Astro.props;
const badgeName =
  badge && translate(strings, 'translation.badgeLabel', { locale: localeNames[badge] ?? badge });
---

<a href={href} hreflang={badge} lang={badge} class={className}>
  {title}
  {badge && (
    <Tag tone="faint" bordered role="img" aria-label={badgeName} class="ml-2 align-middle">
      {badge}
    </Tag>
  )}
</a>
