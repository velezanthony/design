---
import type { ComponentProps } from 'astro/types';
import type { CoverView } from '../../core/listing/covers';
import type { ListingView } from '../../core/listing/view';
import { splitNavTrees, type NavTreeNode } from '../../core/navigation/nav-tree';
import DocsLayout from '../layouts/DocsLayout.astro';
import NavTree from '../molecules/navigation/NavTree.astro';
import Listing from '../organisms/content/Listing.astro';

/* Solo pinta: la ruta lee los datos, arma el modelo y renderiza el Markdown (su `Content` llega como slot). */
type Props = ComponentProps<typeof DocsLayout> & {
  /** Árboles de `::nav-tree`, uno por posición de `nav`: cada hueco del Markdown se rellena con el suyo. */
  navTrees?: NavTreeNode[][];
  /** Índice generado (un `_index.md` o una carpeta de `indexes`): su listado va debajo del contenido, fuera de `.prose`. */
  listing?: ListingView<CoverView>;
};

const { navTrees, listing, ...layout } = Astro.props;
/* Desde la página 2 de un listado el cuerpo no se repite: solo el título y en qué página se está. */
const heading = listing?.layout !== 'list' ? listing?.pageHeading : undefined;
const segments = !heading && navTrees && splitNavTrees(await Astro.slots.render('default'));
/* Los encabezados de las secciones de una lista entran en «En esta página». */
const listingHeadings = listing?.layout === 'list' ? listing.headings : [];
const headings = heading ? [] : [...layout.headings, ...listingHeadings];
---

<DocsLayout {...layout} headings={headings}>
  <slot name="head" slot="head" />
  <slot name="scripts" slot="scripts" />
  {listing && (
    <div slot="below" class="mt-12">
      <Listing view={listing} strings={layout.strings} />
    </div>
  )}
  {heading ? (
    <Fragment>
      <h1>{heading.title}</h1>
      <p class="text-faint">{heading.page}</p>
    </Fragment>
  ) : segments ? (
    segments.map((segment) =>
      segment.kind === 'html' ? (
        <Fragment set:html={segment.html} />
      ) : (
        <NavTree
          nodes={navTrees[segment.section] ?? []}
          descriptions={segment.descriptions}
          strings={layout.strings}
        />
      ),
    )
  ) : (
    <slot />
  )}
</DocsLayout>
