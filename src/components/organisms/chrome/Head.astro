---
import type { HeadConfig } from '../../../core/seo/head';

interface Props {
  /** Etiquetas del `<head>` como datos (`buildHead`); aquí solo se pintan. */
  head: HeadConfig[];
}

const { head } = Astro.props;
---

{head.map(({ tag, attrs, content }) =>
  tag === 'title' ? (
    <title>{content}</title>
  ) : tag === 'meta' ? (
    <meta {...attrs} />
  ) : tag === 'script' ? (
    // `content` ya viene escapado por `serializeJsonLd`; `set:html` no lo toca (un escape HTML rompería el JSON).
    <script {...attrs} set:html={content} />
  ) : (
    <link {...attrs} />
  ),
)}
