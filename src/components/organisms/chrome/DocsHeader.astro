---
import type { Locale } from '../../../core/i18n/locale';
import { translate, type UiStrings } from '../../../core/i18n/ui-strings';
import type { NavEntry } from '../../../core/navigation/nav-entries';
import LocaleSwitch from '../../molecules/navigation/LocaleSwitch.astro';
import NavList from '../../molecules/navigation/NavList.astro';
import ThemeToggle from '../../molecules/controls/ThemeToggle.astro';

interface Props {
  /** Nombre del sitio: enlaza a la portada del idioma. */
  siteName: string;
  homeHref: string;
  lang: Locale;
  /** URL de la misma página en cada idioma en que existe (ver `LocaleSwitch`). */
  hrefs: Partial<Record<Locale, string>>;
  strings: UiStrings;
  /** Items de la cabecera (secciones, páginas y enlaces): desde lg van tras el nombre del sitio. */
  nav?: NavEntry[];
  /** Id del contenedor principal al que salta el enlace de salto. */
  mainId?: string;
  /** Pinta el conmutador de ancho Lectura / Ancho (`layout.toggles`). */
  layoutToggles?: boolean;
  /** Ancho con el que nace el conmutador; `initLayout` lo corrige con lo guardado. */
  layoutWidth?: 'reading' | 'full';
}

const {
  siteName,
  homeHref,
  lang,
  hrefs,
  strings,
  nav = [],
  mainId = 'main-content',
  layoutToggles = false,
  layoutWidth = 'reading',
} = Astro.props;
const widths = [
  {
    value: 'reading',
    label: translate(strings, 'layout.reading'),
    /* Líneas de texto en una columna estrecha, con margen a los lados. */
    lines: 'M6 6h4M6 8h4M6 10h2.5',
  },
  {
    value: 'full',
    label: translate(strings, 'layout.full'),
    /* Las mismas líneas de borde a borde. */
    lines: 'M4 6h8M4 8h8M4 10h5',
  },
] as const;
---

{/* Lo primero que alcanza el tabulador: salta la cabecera y la barra lateral. */}
<a
  href={`#${mainId}`}
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-canvas focus:px-4 focus:py-2 focus:text-ink focus:outline focus:outline-2 focus:outline-accent"
>
  {translate(strings, 'skipToContent')}
</a>

{/* `view-transition-name` crea un contexto de apilamiento: el `z-30` del buscador cuenta solo dentro, y la cabecera queda bajo «volver arriba» (40) y las cookies (50). */}
<header class="docs-header relative z-30 bg-chrome">
  <div class="docs-container mx-auto flex max-w-(--page-max) flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-4 lg:px-10">
    <a
      href={homeHref}
      class="docs-brand order-1 inline-flex min-h-6 items-center font-mono text-lg font-semibold tracking-tight text-ink decoration-accent-line decoration-2 underline-offset-4 hover:underline"
    >
      {siteName}
    </a>

    {/* Por debajo de lg los mismos items van en el «Menú» de la barra lateral. */}
    <NavList
      entries={nav}
      strings={strings}
      variant="bar"
      class="hidden lg:order-1 lg:flex lg:flex-1 lg:items-center"
    />

    {/* En móvil: nombre e idioma/tema en la primera fila y el buscador a todo el ancho debajo.
        Desde md, todo en una fila como siempre. */}
    <div class="order-3 w-full md:order-2 md:ml-auto md:w-60">
      <slot />
    </div>
    <div class="order-2 flex items-center gap-1 md:order-3">
      {/* Solo desde md: por debajo no hay columnas que liberar y el ancho completo no aporta. */}
      {layoutToggles && (
        <div
          role="group"
          aria-label={translate(strings, 'layout.width')}
          class="docs-width-switch mr-2 hidden md:inline-flex"
        >
          {widths.map((width) => (
            <button
              type="button"
              data-layout-width={width.value}
              aria-pressed={layoutWidth === width.value ? 'true' : 'false'}
              aria-label={width.label}
              title={width.label}
            >
              {/* Solo icono: una página y sus líneas de texto. El nombre va en `aria-label`. */}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <rect
                  x="1.5"
                  y="2.5"
                  width="13"
                  height="11"
                  rx="1.5"
                  stroke="currentColor"
                  stroke-width="1.2"
                ></rect>
                <path
                  d={width.lines}
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linecap="round"
                ></path>
              </svg>
            </button>
          ))}
        </div>
      )}
      <LocaleSwitch lang={lang} hrefs={hrefs} strings={strings} />
      <ThemeToggle strings={strings} />
    </div>
  </div>
</header>
