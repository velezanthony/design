---
import type { Locale } from '../../../core/i18n/locale';
import type { UiStrings } from '../../../core/i18n/ui-strings';
import type { ListingSection } from '../../../core/listing/entries';
import Heading from '../../atoms/display/Heading.astro';
import ListingTree from '../../molecules/navigation/ListingTree.astro';

/* Índice en lista (`layout: 'list'`): el árbol de la navegación, sin paginar. Cada sección de `nav`
   es un h2 (entra en «En esta página»); las páginas sin sección van al final, sin encabezado. */
interface Props {
  sections: ListingSection[];
  strings: UiStrings;
  lang: Locale;
}

const { sections, strings, lang } = Astro.props;
---

<div data-index-list class="space-y-12">
  {sections.map((section) => (
    <section>
      {section.label && (
        <Heading level={2} size="lg" id={section.id} class="mb-6 border-t border-ink pt-4">
          {section.label}
        </Heading>
      )}
      <ListingTree nodes={section.nodes} strings={strings} lang={lang} />
    </section>
  ))}
</div>
