---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'input'>, 'type' | 'class' | 'id'> {
  /** Obligatorio: es lo que une la etiqueta con el campo (`for`/`id`). */
  id: string;
  /** Texto de la etiqueta. Un campo sin etiqueta no es accesible. */
  label: string;
  type?: 'text' | 'search';
  /** Deja la etiqueta solo para lectores de pantalla (un buscador con placeholder y atajo). */
  hideLabel?: boolean;
  /** Va al contenedor: el ancho lo decide quien coloca el campo; el campo ocupa todo el suyo. */
  class?: string;
}

const { id, label, type = 'text', hideLabel = false, class: className, ...rest } = Astro.props;
---

<div class:list={['flex flex-col gap-1', className]}>
  <label for={id} class:list={[hideLabel ? 'sr-only' : 'label text-muted']}>
    {label}
  </label>
  <input
    id={id}
    type={type}
    class="min-h-8 w-full border border-rule bg-canvas px-2 text-ink placeholder:text-faint focus-visible:border-accent disabled:cursor-not-allowed disabled:opacity-50"
    {...rest}
  />
</div>
