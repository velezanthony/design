---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type Variant = 'inline' | 'quiet' | 'action' | 'value';

interface Props extends Omit<HTMLAttributes<'a'>, 'href' | 'class' | 'target'> {
  href: string;
  variant?: Variant;
  /** Fuerza el tratamiento externo en un enlace que no es http(s). */
  external?: boolean;
  class?: string;
}

const { href, variant = 'inline', external, rel, class: className, ...rest } = Astro.props;

const isExternal = external ?? /^https?:\/\//.test(href);

/* `min-h-6` salvo inline: WCAG 2.5.8 pide objetivos de 24px; los enlaces dentro de una frase están exentos. */
const variants: Record<Variant, string> = {
  inline:
    'text-accent underline decoration-accent-line underline-offset-[0.2em] decoration-1 hover:decoration-2 transition-[text-decoration-thickness]',
  quiet: 'min-h-6 text-muted hover:text-ink transition-colors',
  /* El contenido de un campo con etiqueta: tinta, como los valores de texto que lo acompañan. */
  value: 'min-h-6 text-ink hover:text-accent transition-colors',
  action:
    'label min-h-6 inline-flex items-center gap-2 text-accent hover:gap-3 transition-[gap] duration-200',
};
---

<a
  {...rest}
  href={href}
  rel={[rel, isExternal && 'noopener noreferrer'].filter(Boolean).join(' ') || undefined}
  target={isExternal ? '_blank' : undefined}
  class:list={['inline-flex items-center gap-1.5', variants[variant], className]}
>
  <slot />
  {variant === 'action' && <Icon name="arrow" size={14} />}
  {isExternal && variant !== 'action' && (
    <Icon name="external" size={12} class="shrink-0 opacity-60" />
  )}
</a>
