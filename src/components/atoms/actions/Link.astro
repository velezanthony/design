---
import type { HTMLAttributes } from 'astro/types';
import Icon from '../display/Icon.astro';
import { linkVariants, type LinkVariant } from './variants';

interface Props extends Omit<HTMLAttributes<'a'>, 'href' | 'class' | 'target'> {
  href: string;
  variant?: LinkVariant;
  /** Fuerza el tratamiento externo en un enlace que no es http(s). */
  external?: boolean;
  class?: string;
}

const { href, variant = 'inline', external, rel, class: className, ...rest } = Astro.props;

const isExternal = external ?? /^https?:\/\//.test(href);
---

<a
  {...rest}
  href={href}
  rel={[rel, isExternal && 'noopener noreferrer'].filter(Boolean).join(' ') || undefined}
  target={isExternal ? '_blank' : undefined}
  class:list={['inline-flex items-center gap-1.5', linkVariants[variant], className]}
>
  <slot />
  {variant === 'action' && <Icon name="arrow" size={14} />}
  {isExternal && variant !== 'action' && (
    <Icon name="external" size={12} class="shrink-0 opacity-60" />
  )}
</a>
