---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'textarea'>, 'class' | 'id' | 'value'> {
  /** Obligatorio: es lo que une la etiqueta con el campo (`for`/`id`). */
  id: string;
  name: string;
  value?: string;
  required?: boolean;
  disabled?: boolean;
  /** Marca el campo con `aria-invalid`; el mensaje lo pone quien lo usa (`FieldError`). */
  invalid?: boolean;
  class?: string;
}

const {
  id,
  value = '',
  required = false,
  disabled = false,
  invalid = false,
  class: className,
  ...rest
} = Astro.props;
---

<textarea
  id={id}
  required={required}
  disabled={disabled}
  aria-invalid={invalid ? 'true' : undefined}
  rows="4"
  class:list={[
    'min-h-20 w-full border border-rule bg-canvas px-2 py-1 text-ink placeholder:text-faint focus-visible:border-accent aria-invalid:border-danger disabled:cursor-not-allowed disabled:opacity-50',
    className,
  ]}
  {...rest}
>{value}</textarea>
