---
/* Contenedor de la tabla de páginas. Los filtros viven en la query de la URL (`parseFilters`),
   así que es una ruta bajo demanda: una prerenderizada no vería `Astro.url.searchParams`. */
import { Font } from 'astro:assets';
import { filterPages } from '../../core/seo-on-page/queries/filter';
import { paginate, PAGE_SIZE } from '../../core/seo-on-page/queries/paginate';
import {
  ALL_SEVERITIES,
  filtersFromUrl,
  parsePage,
} from '../../core/seo-on-page/queries/url-filters';
import FiltersForm from '../../ui/seo-on-page/FiltersForm.astro';
import InfoHiddenNote from '../../ui/seo-on-page/InfoHiddenNote.astro';
import Pagination from '../../ui/molecules/Pagination.astro';
import PagesTable from '../../ui/seo-on-page/PagesTable.astro';
import ResultsCount from '../../ui/seo-on-page/ResultsCount.astro';
import { PAGINATION_LABELS } from '../../ui/seo-on-page/labels';
import SeoLayout from '../../ui/seo-on-page/SeoLayout.astro';
import { urlPolicyOf } from '../routes/pages';
import { siteConfig } from '../routes/site-config';
import { loadSeoTree } from './adapter';
import { devHrefs } from './hrefs';

const hrefs = devHrefs(urlPolicyOf(siteConfig));
const { filters, defaulted } = filtersFromUrl(Astro.url.searchParams);
const tree = await loadSeoTree(siteConfig);
const result = paginate(filterPages(tree, filters), parsePage(Astro.url.searchParams), PAGE_SIZE);
const rows = result.rows.map((page) => ({ page, href: hrefs.inspector(page) }));
/* Los enlaces de página llevan los filtros ESCRITOS en la URL: en la vista por defecto no se
   añade `severity`, así pasar de página no la convierte en una vista con filtros explícitos. */
const linkFilters = defaulted ? { ...filters, severities: [] } : filters;
---

<SeoLayout
  title="Páginas"
  siteName={siteConfig.name}
  active="pages"
  hrefs={{ overview: hrefs.overview(), pages: hrefs.pages(), site: hrefs.siteHome() }}
>
  <Fragment slot="head">
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />
  </Fragment>
  <div class="flex flex-col gap-6">
    <FiltersForm filters={filters} locales={siteConfig.locales} action={hrefs.pages()} />
    {defaulted && (
      <InfoHiddenNote showAllHref={hrefs.pages({ ...filters, severities: ALL_SEVERITIES })} />
    )}
    <ResultsCount
      from={result.from}
      to={result.to}
      total={result.total}
      overall={tree.pages.length}
    />
    <PagesTable rows={rows} />
    <Pagination
      page={result.page}
      pages={result.pages}
      labels={PAGINATION_LABELS}
      href={(number) => hrefs.pages(linkFilters, number)}
    />
  </div>
</SeoLayout>
