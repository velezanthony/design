---
/* `/[locale]/[privacy]`: la página de privacidad de cada idioma que no es el de defecto. */
import { Font } from 'astro:assets';
import PrivacyLayout from '../../ui/layouts/PrivacyLayout.astro';
import { loadPrivacyView } from '../data/privacy';
import { siteConfig } from '../data/site-config';
import { privacyRoutes } from '../views/privacy';

export function getStaticPaths() {
  return privacyRoutes(siteConfig).localized.map(({ params }) => ({
    params,
    props: { locale: params.locale },
  }));
}

const view = await loadPrivacyView(Astro.props.locale);
---

<PrivacyLayout {...view} year={new Date().getFullYear()}>
  <Fragment slot="head">
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />
  </Fragment>
</PrivacyLayout>
