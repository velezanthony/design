---
/* Contenedor de la tabla de páginas. Los filtros viven en la query de la URL (`parseFilters`),
   así que es una ruta bajo demanda: una prerenderizada no vería `Astro.url.searchParams`. */
import Fonts from '../Fonts.astro';
import { listingModel } from '../../../core/seo-on-page/pages/listing/model';
import DocsLayout from '../../../components/layouts/DocsLayout.astro';
import FiltersForm from '../../../components/seo-on-page/molecules/FiltersForm.astro';
import InfoHiddenNote from '../../../components/seo-on-page/molecules/InfoHiddenNote.astro';
import CommonIssueNotice from '../../../components/seo-on-page/organisms/CommonIssueNotice.astro';
import PagesListing from '../../../components/seo-on-page/organisms/PagesListing.astro';
import TableFooter from '../../../components/seo-on-page/molecules/TableFooter.astro';
import TableHead from '../../../components/seo-on-page/molecules/TableHead.astro';
import PanelIntro from '../../../components/seo-on-page/molecules/PanelIntro.astro';
import ReportButton from '../../../components/seo-on-page/molecules/ReportButton.astro';
import ReportDialog from '../../../components/seo-on-page/organisms/ReportDialog.astro';
import { headCount, SCREEN_LABELS, VIEW_LABELS } from '../../../components/seo-on-page/labels';
import { siteConfig } from '../../data/site-config';
import ClientPageFailures from '../../../components/seo-on-page/organisms/ClientPageFailures.astro';
import { loadPanel } from '../../data/seo-on-page/adapter';
import { listingReport } from '../../views/seo-on-page/report';
import { panelView } from '../../views/seo-on-page/panel';

const { docs, tree, failures, hrefs } = await loadPanel(siteConfig, Astro.url.origin);
const view = panelView({
  config: siteConfig,
  data: docs,
  hrefs,
  screen: 'pages',
  title: SCREEN_LABELS.pages,
});
const model = listingModel({
  tree,
  params: Astro.url.searchParams,
  locales: siteConfig.locales,
  defaultLocale: siteConfig.defaultLocale,
  links: hrefs,
});
const { footer } = model;
const report = listingReport(tree, Astro.url.searchParams, siteConfig);
---

<DocsLayout {...view} year={new Date().getFullYear()}>
  <Fonts slot="head" />
  <PanelIntro
    title={SCREEN_LABELS.pages}
    lede={VIEW_LABELS[model.view.view].lede}
    strings={view.strings}
  >
    <ReportButton slot="actions" scope="filter" />
  </PanelIntro>
  <ClientPageFailures failures={failures} />
  <div class="flex flex-col gap-6">
    <FiltersForm {...model.form} />
    {model.showAllHref && <InfoHiddenNote showAllHref={model.showAllHref} />}
    <TableHead
      count={headCount(model.table, footer.count.total)}
      views={model.views}
      copyReport={model.table.view === 'have' && model.table.lacks !== undefined}
    />
    {model.common.issues.map((issue) => (
      <CommonIssueNotice issue={issue} overviewHref={model.common.overviewHref} />
    ))}
    <PagesListing table={model.table} />
    <TableFooter
      filters={footer.filters}
      perPage={footer.perPage}
      view={footer.view}
      action={footer.action}
      {...footer.count}
      page={footer.pagination.page}
      pages={footer.pagination.pages}
      href={footer.pagination.href}
    />
  </div>
  <ReportDialog {...report} />
</DocsLayout>

<script>
  import { bootPanel } from '../../../client/seo-on-page/boot';

  bootPanel();
</script>
