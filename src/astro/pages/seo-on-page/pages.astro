---
/* Contenedor de la tabla de páginas. Los filtros viven en la query de la URL (`parseFilters`),
   así que es una ruta bajo demanda: una prerenderizada no vería `Astro.url.searchParams`. */
import { Font } from 'astro:assets';
import { listingModel } from '../../../core/seo-on-page/pages/listing/model';
import DocsLayout from '../../../ui/layouts/DocsLayout.astro';
import FiltersForm from '../../../ui/seo-on-page/molecules/FiltersForm.astro';
import InfoHiddenNote from '../../../ui/seo-on-page/molecules/InfoHiddenNote.astro';
import CommonIssueNotice from '../../../ui/seo-on-page/organisms/CommonIssueNotice.astro';
import PagesListing from '../../../ui/seo-on-page/organisms/PagesListing.astro';
import TableFooter from '../../../ui/seo-on-page/molecules/TableFooter.astro';
import TableHead from '../../../ui/seo-on-page/molecules/TableHead.astro';
import PanelIntro from '../../../ui/seo-on-page/molecules/PanelIntro.astro';
import ReportButton from '../../../ui/seo-on-page/molecules/ReportButton.astro';
import ReportDialog from '../../../ui/seo-on-page/organisms/ReportDialog.astro';
import { urlPolicyOf } from '../../views/pages';
import { headCount, VIEW_LABELS } from '../../../ui/seo-on-page/labels';
import { siteConfig } from '../../data/site-config';
import ClientPageFailures from '../../../ui/seo-on-page/organisms/ClientPageFailures.astro';
import { loadDocData, loadPanelTree } from '../../data/seo-on-page/adapter';
import { devHrefs } from '../../views/seo-on-page/hrefs';
import { listingReport } from '../../views/seo-on-page/report';
import { panelView } from '../../views/seo-on-page/panel';

const hrefs = devHrefs(urlPolicyOf(siteConfig));
const view = panelView({
  cfg: siteConfig,
  data: await loadDocData(),
  hrefs,
  screen: 'pages',
  title: 'Páginas',
});
const { tree, failures } = await loadPanelTree(siteConfig, Astro.url.origin);
const model = listingModel({
  tree,
  params: Astro.url.searchParams,
  locales: siteConfig.locales,
  defaultLocale: siteConfig.defaultLocale,
  links: hrefs,
});
const { footer } = model;
const report = listingReport(tree, Astro.url.searchParams, siteConfig);
---

<DocsLayout {...view} year={new Date().getFullYear()}>
  <Fragment slot="head">
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />
  </Fragment>
  <PanelIntro title="Páginas" lede={VIEW_LABELS[model.view.view].lede} strings={view.strings}>
    <ReportButton slot="actions" scope="filter" />
  </PanelIntro>
  <ClientPageFailures failures={failures} />
  <div class="flex flex-col gap-6">
    <FiltersForm {...model.form} />
    {model.showAllHref && <InfoHiddenNote showAllHref={model.showAllHref} />}
    <TableHead
      count={headCount(model.table, footer.count.total)}
      views={model.views}
      copyReport={model.table.view === 'have' && model.table.lacks !== undefined}
    />
    {model.common.issues.map((issue) => (
      <CommonIssueNotice issue={issue} overviewHref={model.common.overviewHref} />
    ))}
    <PagesListing table={model.table} />
    <TableFooter
      filters={footer.filters}
      perPage={footer.perPage}
      view={footer.view}
      action={footer.action}
      {...footer.count}
      page={footer.pagination.page}
      pages={footer.pagination.pages}
      href={footer.pagination.href}
    />
  </div>
  <ReportDialog {...report} />
</DocsLayout>

<script>
  import { bootPanel } from '../../../client/seo-on-page/boot';

  bootPanel();
</script>
