---
/* Contenedor del inspector: una página e idioma elegidos por la query (`?slug=…&locale=…`; la
   portada tiene slug vacío). Ruta bajo demanda por lo mismo que la tabla. */
import { Font } from 'astro:assets';
import { inspectorModel } from '../../../core/seo-on-page/pages/inspector/model';
import DocsLayout from '../../../ui/layouts/DocsLayout.astro';
import Link from '../../../ui/atoms/Link.astro';
import HeadingsOutline from '../../../ui/seo-on-page/organisms/HeadingsOutline.astro';
import IssuesList from '../../../ui/seo-on-page/organisms/IssuesList.astro';
import Previews from '../../../ui/seo-on-page/organisms/Previews.astro';
import PublishedFacts from '../../../ui/seo-on-page/organisms/PublishedFacts.astro';
import SchemasList from '../../../ui/seo-on-page/organisms/SchemasList.astro';
import Translations from '../../../ui/seo-on-page/organisms/Translations.astro';
import { slugLabel } from '../../../ui/seo-on-page/labels';
import PanelIntro from '../../../ui/seo-on-page/molecules/PanelIntro.astro';
import { urlPolicyOf } from '../../views/pages';
import { siteConfig } from '../../data/site-config';
import { loadDocData, loadSeoTree } from '../../data/seo-on-page/adapter';
import { assetHref, devHrefs } from '../../views/seo-on-page/hrefs';
import { inspectorHeadings, panelView } from '../../views/seo-on-page/panel';

const hrefs = devHrefs(urlPolicyOf(siteConfig));
const { searchParams } = Astro.url;
const slug = searchParams.get('slug') ?? '';
const locale = searchParams.get('locale') ?? siteConfig.defaultLocale;
const model = inspectorModel({
  tree: await loadSeoTree(siteConfig),
  slug,
  locale,
  links: hrefs,
  site: siteConfig.site,
  asset: (src) => assetHref(siteConfig.base, src),
});
if (!model) Astro.response.status = 404;
const title = model ? `${slugLabel(slug)} · ${locale}` : 'Página no encontrada';
const view = panelView({
  cfg: siteConfig,
  data: await loadDocData(),
  hrefs,
  screen: 'pages',
  title,
  headings: model ? inspectorHeadings() : [],
});
---

<DocsLayout {...view} year={new Date().getFullYear()}>
  <Fragment slot="head">
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />
  </Fragment>
  <PanelIntro title={title} strings={view.strings} />
  {model ? (
    <div class="flex flex-col gap-10">
      <p class="flex flex-wrap gap-x-6 gap-y-1">
        <Link href={model.links.pages}>← Todas las páginas</Link>
        <Link href={model.links.live}>Abrir la página real</Link>
      </p>
      <PublishedFacts published={model.published} />
      <Previews previews={model.previews} />
      <IssuesList issues={model.issues} />
      <SchemasList schemas={model.schemas} />
      <HeadingsOutline outline={model.outline} />
      <Translations translations={model.translations} slug={model.slug} />
    </div>
  ) : (
    <p class="text-ink">
      No hay ninguna página con slug «{slug}» en «{locale}».
      <Link href={hrefs.pages()}>Ver la tabla</Link>
    </p>
  )}
</DocsLayout>
