---
/* Contenedor de la vista general del panel SEO; solo existe con `astro dev`. */
import Fonts from '../Fonts.astro';
import { overviewModel } from '../../../core/seo-on-page/pages/overview/model';
import DocsLayout from '../../../components/layouts/DocsLayout.astro';
import CoverageCard from '../../../components/seo-on-page/organisms/CoverageCard.astro';
import FixFirstCard from '../../../components/seo-on-page/organisms/FixFirstCard.astro';
import IndexingCard from '../../../components/seo-on-page/organisms/IndexingCard.astro';
import KindsCard from '../../../components/seo-on-page/organisms/KindsCard.astro';
import OverviewKpis from '../../../components/seo-on-page/organisms/OverviewKpis.astro';
import SchemasCard from '../../../components/seo-on-page/organisms/SchemasCard.astro';
import SiteFilesCard from '../../../components/seo-on-page/organisms/SiteFilesCard.astro';
import PanelIntro from '../../../components/seo-on-page/molecules/PanelIntro.astro';
import ReportButton from '../../../components/seo-on-page/molecules/ReportButton.astro';
import ReportDialog from '../../../components/seo-on-page/organisms/ReportDialog.astro';
import { OVERVIEW_LABELS, SCREEN_LABELS } from '../../../components/seo-on-page/labels';
import { siteConfig } from '../../data/site-config';
import ClientPageFailures from '../../../components/seo-on-page/organisms/ClientPageFailures.astro';
import RouteOverridesNotice from '../../../components/seo-on-page/organisms/RouteOverridesNotice.astro';
import { loadPanel, loadSiteFiles } from '../../data/seo-on-page/adapter';
import { overviewReport } from '../../views/seo-on-page/report';
import { panelView } from '../../views/seo-on-page/panel';

const { docs, tree, client, failures, overrides, hrefs } = await loadPanel(
  siteConfig,
  Astro.url.origin,
);
const model = overviewModel(tree, {
  locales: siteConfig.locales,
  defaultLocale: siteConfig.defaultLocale,
  links: hrefs,
  siteFiles: await loadSiteFiles(siteConfig, docs, client),
});
const view = panelView({
  config: siteConfig,
  data: docs,
  hrefs,
  screen: 'overview',
  title: SCREEN_LABELS.overview,
});
const report = overviewReport(tree, siteConfig);
const lede = OVERVIEW_LABELS.lede(siteConfig.name, model.kpis.pages.pages, siteConfig.locales);
---

<DocsLayout {...view} year={new Date().getFullYear()}>
  <Fonts slot="head" />
  <PanelIntro title={SCREEN_LABELS.overview} lede={lede} strings={view.strings}>
    <ReportButton slot="actions" scope="site" />
  </PanelIntro>
  <ClientPageFailures failures={failures} />
  <RouteOverridesNotice overrides={overrides} />
  <div class="flex flex-col gap-4">
    <OverviewKpis kpis={model.kpis} />
    <div class="grid gap-4 lg:grid-cols-2">
      <FixFirstCard priorities={model.priorities} footer={model.footer} />
      {model.coverage && <CoverageCard coverage={model.coverage} />}
      <IndexingCard indexing={model.indexing} />
      <SchemasCard schemas={model.schemas} />
      <KindsCard kinds={model.kinds} />
      <SiteFilesCard files={model.files} locales={siteConfig.locales} />
    </div>
  </div>
  <ReportDialog {...report} />
</DocsLayout>

<script>
  import { bootPanel } from '../../../client/seo-on-page/boot';

  bootPanel();
</script>
