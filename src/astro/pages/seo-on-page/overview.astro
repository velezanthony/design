---
/* Contenedor de la vista general del panel SEO on page. Solo existe con `astro dev` (la
   integración no inyecta la ruta en la build). Lee la colección por el adaptador y pasa a la UI
   los datos ya calculados. */
import { Font } from 'astro:assets';
import { overviewModel } from '../../../core/seo-on-page/pages/overview/model';
import DocsLayout from '../../../ui/layouts/DocsLayout.astro';
import Overview from '../../../ui/seo-on-page/organisms/Overview.astro';
import PanelIntro from '../../../ui/seo-on-page/molecules/PanelIntro.astro';
import { urlPolicyOf } from '../../views/pages';
import { siteConfig } from '../../data/site-config';
import { loadDocData, loadSeoTree } from '../../data/seo-on-page/adapter';
import { devHrefs } from '../../views/seo-on-page/hrefs';
import { panelView } from '../../views/seo-on-page/panel';

const hrefs = devHrefs(urlPolicyOf(siteConfig));
const model = overviewModel(await loadSeoTree(siteConfig), hrefs);
const view = panelView({
  cfg: siteConfig,
  data: await loadDocData(),
  hrefs,
  screen: 'overview',
  title: 'Resumen',
});
---

<DocsLayout {...view} year={new Date().getFullYear()}>
  <Fragment slot="head">
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />
  </Fragment>
  <PanelIntro title="Resumen" strings={view.strings} />
  <Overview model={model} />
</DocsLayout>
