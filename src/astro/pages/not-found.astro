---
/* Contenedor de la 404. `/404` (→ `404.html`, el único que sirve GitHub Pages) es el idioma por
   defecto con una plantilla por cada otro idioma; `/[locale]/404` pinta el suyo directamente. */
import { Font } from 'astro:assets';
import NotFoundLayout from '../../ui/layouts/NotFoundLayout.astro';
import { readImageSizes } from '../loader/images';
import { notFoundRoutes, notFoundView } from '../views/not-found';
import { getDocs } from '../data/docs-collection';
import { siteConfig } from '../data/site-config';

export function getStaticPaths() {
  return notFoundRoutes(siteConfig);
}

const sizes = await readImageSizes(
  [siteConfig.seo.image?.src].filter((src) => src !== undefined),
  new URL(siteConfig.publicDir),
);
const data = (await getDocs()).map((entry) => entry.data);
const view = notFoundView(Astro.params.locale, siteConfig, sizes, data);
---

<NotFoundLayout {...view} year={new Date().getFullYear()}>
  <Fragment slot="head">
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />
  </Fragment>
</NotFoundLayout>
