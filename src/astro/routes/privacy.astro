---
/* `/[privacy]`: la página de privacidad del idioma por defecto, sin prefijo (solo con `privacy.page`). */
import Fonts from './Fonts.astro';
import PrivacyPage from '../../components/pages/PrivacyPage.astro';
import { loadPrivacyView } from '../data/privacy';
import { siteConfig } from '../data/site-config';
import { privacyRoutes } from '../views/privacy';

export function getStaticPaths() {
  return privacyRoutes(siteConfig).main;
}

const view = await loadPrivacyView();
---

<PrivacyPage {...view} year={new Date().getFullYear()}>
  <Fonts slot="head" />
</PrivacyPage>
