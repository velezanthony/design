---
/* Cuerpo común de la página de privacidad propia: lo comparten `privacy.astro` (idioma por
   defecto, sin prefijo) y `privacy-locale.astro` (los demás). Son dos contenedores porque cada
   patrón (`/[privacy]`, `/[locale]/[privacy]`) tiene sus propios `getStaticPaths`. */
import { Font } from 'astro:assets';
import PrivacyLayout from '../../ui/layouts/PrivacyLayout.astro';
import { readImageSizes } from '../loader/images';
import { getDocs } from './docs-collection';
import { privacyView } from './privacy-view';
import { siteConfig } from './site-config';

interface Props {
  locale?: string;
}

const sizes = await readImageSizes(
  [siteConfig.seo.image?.src].filter((src) => src !== undefined),
  new URL(siteConfig.publicDir ?? 'file:///'),
);
const data = (await getDocs()).map((entry) => entry.data);
const view = privacyView(Astro.props.locale, siteConfig, sizes, data);
---

<PrivacyLayout {...view} year={new Date().getFullYear()}>
  <Fragment slot="head">
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />
  </Fragment>
</PrivacyLayout>
