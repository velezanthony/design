---
/* Contenedor de la 404. `/404` (→ `404.html`, el único que sirve GitHub Pages) es el idioma por
   defecto con una plantilla por cada otro idioma; `/[locale]/404` pinta el suyo directamente. */
import Fonts from './Fonts.astro';
import NotFoundPage from '../../components/pages/NotFoundPage.astro';
import { notFoundRoutes, notFoundView } from '../views/not-found';
import { getDocData } from '../data/docs-collection';
import { siteImageSizes } from '../data/image-sizes';
import { siteConfig } from '../data/site-config';

export function getStaticPaths() {
  return notFoundRoutes(siteConfig);
}

const view = notFoundView({
  locale: Astro.params.locale,
  config: siteConfig,
  data: await getDocData(),
  sizes: await siteImageSizes(siteConfig),
});
---

<NotFoundPage {...view} year={new Date().getFullYear()}>
  <Fonts slot="head" />
</NotFoundPage>
