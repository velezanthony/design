---
/* Contenedor mínimo de la 404 (la Fase 12 añade la plantilla por idioma y el script previo al
   pintado). `/404` usa el idioma por defecto; `/[locale]/404` cada uno de los demás. */
import config from 'virtual:@velezanthony/design/config';
import { pageUrl } from '../../core/i18n/availability';
import NotFound from '../../ui/organisms/NotFound.astro';

export function getStaticPaths() {
  return config.locales
    .filter((locale) => locale !== config.defaultLocale)
    .map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale ?? config.defaultLocale;
const homeHref = pageUrl('', locale, config);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{config.strings[locale]['notFound.title']}</title>
  </head>
  <body>
    <main data-pagefind-ignore>
      <NotFound
        strings={config.strings[locale] as never}
        homeHref={homeHref}
        baseUrl={config.base}
      />
    </main>
  </body>
</html>
