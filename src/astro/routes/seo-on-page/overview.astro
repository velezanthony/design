---
/* Contenedor de la vista general del panel SEO; solo existe con `astro dev`. */
import Fonts from '../Fonts.astro';
import Footer from 'virtual:@velezanthony/design/components/Footer';
import { overviewModel } from '../../../core/seo-on-page/pages/overview/model';
import OverviewPage from '../../../components/seo-on-page/pages/OverviewPage.astro';
import { SCREEN_LABELS } from '../../../core/seo-on-page/labels';
import { urlPolicyOf } from '../../config';
import { siteConfig } from '../../data/site-config';
import { loadPanel, loadSiteFiles } from '../../data/seo-on-page/adapter';
import { overviewReport } from '../../views/seo-on-page/report';
import { devHrefs } from '../../views/seo-on-page/hrefs';
import { panelView } from '../../views/seo-on-page/panel';

const { docs, tree, client, failures, overrides } = await loadPanel(siteConfig, Astro.url.origin);
/* Los enlaces del panel los arma la ruta: `data/` no conoce `views/`. */
const hrefs = devHrefs(urlPolicyOf(siteConfig, siteConfig.defaultLocale));
const model = overviewModel(tree, {
  locales: siteConfig.locales,
  defaultLocale: siteConfig.defaultLocale,
  links: hrefs,
  siteFiles: await loadSiteFiles(siteConfig, docs, client),
});
const view = panelView({
  config: siteConfig,
  data: docs,
  hrefs,
  screen: 'overview',
  title: SCREEN_LABELS.overview,
});
const report = overviewReport(tree, siteConfig);
---

<OverviewPage
  view={view}
  year={new Date().getFullYear()}
  Footer={Footer}
  model={model}
  locales={siteConfig.locales}
  failures={failures}
  overrides={overrides}
  report={report}
>
  <Fonts slot="head" />
</OverviewPage>
