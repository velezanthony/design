---
/* Contenedor de la vista general del panel SEO on page. Solo existe con `astro dev` (la
   integración no inyecta la ruta en la build). Lee la colección por el adaptador y pasa a la UI
   los datos ya calculados. */
import { Font } from 'astro:assets';
import { summarize } from '../../../core/seo-on-page/queries/summary';
import { ALL_SEVERITIES, EMPTY_FILTERS } from '../../../core/seo-on-page/queries/url-filters';
import DocsLayout from '../../../ui/layouts/DocsLayout.astro';
import Overview from '../../../ui/seo-on-page/organisms/Overview.astro';
import PanelIntro from '../../../ui/seo-on-page/molecules/PanelIntro.astro';
import { urlPolicyOf } from '../pages';
import { siteConfig } from '../site-config';
import { loadDocData, loadSeoTree } from './adapter';
import { devHrefs } from './hrefs';
import { panelView } from './panel-view';

const url = urlPolicyOf(siteConfig);
const hrefs = devHrefs(url);
const summary = summarize(await loadSeoTree(siteConfig));
const view = panelView({
  cfg: siteConfig,
  data: await loadDocData(),
  hrefs,
  screen: 'overview',
  title: 'Resumen',
});
---

<DocsLayout {...view} year={new Date().getFullYear()}>
  <Fragment slot="head">
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />
  </Fragment>
  <PanelIntro title="Resumen" strings={view.strings} />
  <Overview
    summary={summary}
    hrefs={{
      pages: hrefs.pages(),
      all: hrefs.pages({ ...EMPTY_FILTERS, severities: ALL_SEVERITIES }),
      kind: (kind) => hrefs.pages({ ...EMPTY_FILTERS, kinds: [kind] }),
      severity: (severity) => hrefs.pages({ ...EMPTY_FILTERS, severities: [severity] }),
    }}
  />
</DocsLayout>
