---
import type { Locale } from '../../core/i18n/locale';
import type { UiStrings } from '../../core/i18n/ui-strings';
import type { FooterView } from '../../core/navigation/footer';
import type { NavEntry } from '../../core/navigation/nav-entries';
import type { PrivacySection } from '../../core/privacy/copy';
import type { HeadConfig } from '../../core/seo/head';
import BackToTop from '../organisms/BackToTop.astro';
import ConsentBanner from '../organisms/ConsentBanner.astro';
import DocsFooter from '../organisms/DocsFooter.astro';
import DocsHeader from '../organisms/DocsHeader.astro';
import PrivacyPolicy from '../organisms/PrivacyPolicy.astro';
import SearchBox from '../organisms/SearchBox.astro';
import Shell from './Shell.astro';

/* La política con el cromo de la documentación (cabecera, pie y consentimiento) pero SIN barra
   lateral ni índice: es un texto legal de una sola columna, no una página de una sección. */
interface Props {
  lang: Locale;
  head: HeadConfig[];
  siteName: string;
  homeHref: string;
  /** URL de la política en cada idioma, para el selector de idioma. */
  hrefs: Partial<Record<Locale, string>>;
  strings: UiStrings;
  nav?: NavEntry[];
  footer?: FooterView;
  baseUrl: string;
  year: number;
  /** Con `gtmId` es obligatoria: el aviso de consentimiento enlaza a ella. */
  privacyUrl?: string;
  gtmId?: string;
  title: string;
  sections: PrivacySection[];
  updated: { iso: string; text: string };
}

const {
  lang,
  head,
  siteName,
  homeHref,
  hrefs,
  strings,
  nav = [],
  footer,
  baseUrl,
  year,
  privacyUrl,
  gtmId,
  title,
  sections,
  updated,
} = Astro.props;

if (gtmId && !privacyUrl) {
  throw new Error('PrivacyLayout: `privacyUrl` es obligatoria cuando se define `gtmId`.');
}
---

<Shell lang={lang} head={head}>
  <slot name="head" slot="head" />
  <DocsHeader
    siteName={siteName}
    homeHref={homeHref}
    lang={lang}
    hrefs={hrefs}
    strings={strings}
    nav={nav}
  >
    <SearchBox strings={strings} baseUrl={baseUrl} compactLabel />
  </DocsHeader>
  <main
    id="main-content"
    class="mx-auto max-w-(--container-page) px-6 lg:px-10"
    data-pagefind-ignore
    data-anchor-label={strings['heading.anchor']}
  >
    <PrivacyPolicy
      title={title}
      eyebrow={strings['privacy.eyebrow']}
      updatedLabel={strings['privacy.updated']}
      updated={updated}
      sections={sections}
    />
  </main>
  <DocsFooter
    siteName={siteName}
    year={year}
    strings={strings}
    privacyUrl={privacyUrl}
    cookieControl={Boolean(gtmId)}
    footer={footer}
  />
  {gtmId && privacyUrl && <ConsentBanner gtmId={gtmId} privacyUrl={privacyUrl} strings={strings} />}
  <BackToTop strings={strings} />
  <script>
    import { bootDocs } from './boot';

    bootDocs();
  </script>
</Shell>
