---
import { sidebarScrollScript } from '../../client/sidebar-scroll';
import { DEFAULT_LAYOUT, type ResolvedLayout } from '../../core/config/layout';
import type { Locale } from '../../core/i18n/locale';
import { t, type UiStrings } from '../../core/i18n/ui-strings';
import type { FooterView } from '../../core/navigation/footer';
import type { NavEntry } from '../../core/navigation/nav-entries';
import type { SidebarNode } from '../../core/navigation/sidebar';
import type { HeadConfig } from '../../core/seo/head';
import EditLink from '../molecules/EditLink.astro';
import FallbackNotice from '../molecules/FallbackNotice.astro';
import NavList from '../molecules/NavList.astro';
import PanelToggle from '../molecules/PanelToggle.astro';
import PrevNext from '../molecules/PrevNext.astro';
import TableOfContents from '../molecules/TableOfContents.astro';
import BackToTop from '../organisms/BackToTop.astro';
import ConsentBanner from '../organisms/ConsentBanner.astro';
import DocsFooter from '../organisms/DocsFooter.astro';
import DocsHeader from '../organisms/DocsHeader.astro';
import SearchBox from '../organisms/SearchBox.astro';
import Sidebar from '../organisms/Sidebar.astro';
import Shell from './Shell.astro';

interface Props {
  lang: Locale;
  head: HeadConfig[];
  siteName: string;
  homeHref: string;
  /** URL de esta página en cada idioma en que existe. */
  hrefs: Partial<Record<Locale, string>>;
  strings: UiStrings;
  sidebar: SidebarNode[];
  /** Items de la cabecera; en móvil abren el «Menú», antes de la barra lateral de la sección. */
  nav?: NavEntry[];
  footer?: FooterView;
  /** URL de esta página (la entrada de la barra lateral que lleva `aria-current`). */
  current: string;
  headings: { depth: number; slug: string; text: string }[];
  prev?: { label: string; href: string };
  next?: { label: string; href: string };
  editUrl?: string;
  editFile?: string;
  /** Con `gtmId` es obligatoria: el aviso de consentimiento enlaza a ella. */
  privacyUrl?: string;
  gtmId?: string;
  /** Una página `noindex` o de reserva va fuera del índice de búsqueda. */
  indexable: boolean;
  baseUrl: string;
  year: number;
  /** Solo en una ruta de reserva: el contenido es el del idioma original. */
  fallback?: { originalLocale: Locale; href: string };
  /** Columnas plegables y ancho; sin él, todo abierto, en lectura y con los controles. */
  layout?: ResolvedLayout;
}

const {
  lang,
  head,
  siteName,
  homeHref,
  hrefs,
  strings,
  sidebar,
  nav = [],
  footer,
  current,
  headings,
  prev,
  next,
  editUrl,
  editFile,
  privacyUrl,
  gtmId,
  indexable,
  baseUrl,
  year,
  fallback,
  layout = DEFAULT_LAYOUT,
} = Astro.props;

if (gtmId && !privacyUrl) {
  throw new Error('DocsLayout: `privacyUrl` es obligatoria cuando se define `gtmId`.');
}

/* Pagefind solo indexa lo que cuelga de `data-pagefind-body`; lo demás, ni se marca. */
const pagefind = indexable ? { 'data-pagefind-body': '' } : { 'data-pagefind-ignore': '' };
---

<Shell lang={lang} head={head} layout={layout}>
  <slot name="head" slot="head" />
  <DocsHeader
    siteName={siteName}
    homeHref={homeHref}
    lang={lang}
    hrefs={hrefs}
    strings={strings}
    nav={nav}
    layoutToggles={layout.toggles}
    layoutWidth={layout.width}
  >
    <SearchBox strings={strings} baseUrl={baseUrl} />
  </DocsHeader>

  <div class="docs-container docs-page mx-auto grid max-w-(--page-max) gap-x-10 gap-y-8 px-6 py-8 lg:grid-cols-[var(--col-left)_minmax(0,1fr)] lg:gap-y-0 lg:px-10 lg:py-0 xl:grid-cols-[var(--col-left)_minmax(0,1fr)_var(--col-right)]">
    {/* `aside` es el plano (fondo y bordes, de la altura de la columna); lo que se desplaza, con su
        propia barra, es el contenedor pegajoso de dentro. */}
    <aside class="docs-sidebar">
      <div
        class="docs-sidebar-scroll lg:sticky lg:top-0 lg:max-h-dvh lg:overflow-y-auto"
        data-docs-sidebar-scroll
      >
        {layout.toggles && (
          <PanelToggle
            side="left"
            controls="docs-nav-panel"
            open={layout.sidebar === 'open'}
            strings={strings}
          />
        )}
        <div id="docs-nav-panel" class="docs-panel">
          {/* En móvil la navegación entera iría antes del contenido: se pliega tras un «Menú». Llega
          abierta (sin JS se ve como siempre) y el script la cierra por debajo de lg antes de pintar;
          desde lg el botón no existe y queda abierta. */}
          <details class="docs-nav" open data-docs-nav>
            <summary class="docs-nav-toggle lg:hidden">{t(strings, 'sidebar.toggle')}</summary>
            <NavList
              entries={nav}
              strings={strings}
              variant="menu"
              class="mb-4 border-b border-rule pb-4 lg:hidden"
            />
            <Sidebar nodes={sidebar} current={current} strings={strings} />
          </details>
          <script is:inline>
            (() => {
              const nav = document.currentScript.previousElementSibling;
              const wide = matchMedia('(min-width: 64rem)');
              const sync = () => {
                nav.open = wide.matches;
              };
              sync();
              wide.addEventListener('change', sync);
            })();
          </script>
        </div>
        {/* Tras la barra, antes del primer pintado: al cambiar de página recupera el desplazamiento (o
        centra la entrada actual) sin que se vea el salto. */}
        <script is:inline set:html={sidebarScrollScript()} />
      </div>
    </aside>

    <main
      id="main-content"
      class="min-w-0 lg:py-8"
      {...pagefind}
      data-copy-label={t(strings, 'copy.label')}
      data-copied-label={t(strings, 'copy.copied')}
      data-copy-failed-label={t(strings, 'copy.failed')}
      data-anchor-label={strings['heading.anchor']}
      data-zoom-label={strings['zoom.open']}
      data-zoom-close-label={t(strings, 'zoom.close')}
    >
      {fallback && (
        <FallbackNotice
          originalLocale={fallback.originalLocale}
          href={fallback.href}
          strings={strings}
        />
      )}
      {/* `.prose` es la utilidad que da estilo al Markdown renderizado (encabezados, código, anclas,
          admoniciones, pestañas). Va solo en el contenido: el cromo de debajo no la hereda. */}
      <div class="prose" lang={fallback?.originalLocale}>
        <slot />
      </div>
      <div data-pagefind-ignore>
        {editUrl && editFile && <EditLink editUrl={editUrl} file={editFile} strings={strings} />}
        <PrevNext prev={prev} next={next} strings={strings} />
      </div>
    </main>

    <div class="hidden xl:block xl:py-8">
      <TableOfContents
        headings={headings}
        strings={strings}
        toggles={layout.toggles}
        open={layout.toc === 'open'}
      />
    </div>
  </div>

  <DocsFooter
    siteName={siteName}
    year={year}
    strings={strings}
    privacyUrl={privacyUrl}
    cookieControl={Boolean(gtmId)}
    footer={footer}
  />
  {gtmId && privacyUrl && <ConsentBanner gtmId={gtmId} privacyUrl={privacyUrl} strings={strings} />}
  <BackToTop strings={strings} />
  <script>
    import { bootDocs } from './boot';

    bootDocs();
  </script>
</Shell>
