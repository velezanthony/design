---
interface Props {
  /** Página actual (ya acotada) y total de páginas. */
  page: number;
  pages: number;
  /** Enlace a una página de la tabla; ya lleva los filtros activos. */
  href: (page: number) => string;
}

const { page, pages, href } = Astro.props;

/* Con pocas páginas, todas; con muchas, la primera, la última y las vecinas de la actual, con huecos. */
const SHOW_ALL_UP_TO = 7;
const numbers =
  pages <= SHOW_ALL_UP_TO
    ? Array.from({ length: pages }, (_, index) => index + 1)
    : [...new Set([1, page - 1, page, page + 1, pages])]
        .filter((number) => number >= 1 && number <= pages)
        .sort((a, b) => a - b);
const items = numbers.flatMap((number, index) =>
  index > 0 && number - numbers[index - 1]! > 1 ? [undefined, number] : [number],
);
const link =
  'inline-flex min-h-8 min-w-8 items-center justify-center px-2 text-accent underline underline-offset-[0.2em]';
const current =
  'inline-flex min-h-8 min-w-8 items-center justify-center border border-accent bg-accent-soft px-2 text-ink';
---

{pages > 1 && (
  /* Enlaces de verdad: funciona sin JavaScript, con teclado y con atrás/adelante. */
  <nav aria-label="Paginación de la tabla">
    <ul class="flex flex-wrap items-center gap-1">
      {page > 1 && (
        <li>
          <a href={href(page - 1)} rel="prev" class={link}>
            ← Anterior
          </a>
        </li>
      )}
      {items.map((item) => (
        <li>
          {item === undefined ? (
            <span data-gap aria-hidden="true" class="px-1 text-muted">
              …
            </span>
          ) : item === page ? (
            <a data-page href={href(item)} aria-current="page" class={current}>
              {item}
            </a>
          ) : (
            <a data-page href={href(item)} aria-label={`Página ${item}`} class={link}>
              {item}
            </a>
          )}
        </li>
      ))}
      {page < pages && (
        <li>
          <a href={href(page + 1)} rel="next" class={link}>
            Siguiente →
          </a>
        </li>
      )}
    </ul>
  </nav>
)}
