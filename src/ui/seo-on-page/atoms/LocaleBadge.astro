---
import type { LocaleTone } from '../../../core/seo-on-page/pages/listing/rows';
import { LOCALE_TONE_LABELS } from '../labels';

interface Props {
  locale: string;
  /** Su peor gravedad; «ok» sin incidencias y «missing» si la página no existe en ese idioma. */
  tone: LocaleTone;
}

const { locale, tone } = Astro.props;

/* El color nunca va solo: cada tono lleva un glifo y el texto (oculto) para lectores de pantalla. */
const tones: Record<LocaleTone, { classes: string; glyph: string }> = {
  error: { classes: 'text-danger', glyph: '■' },
  warning: { classes: 'text-state-wip', glyph: '▲' },
  info: { classes: 'text-muted', glyph: '•' },
  ok: { classes: 'text-state-live', glyph: '' },
  missing: { classes: 'border-dashed text-faint line-through', glyph: '' },
};
const { classes, glyph } = tones[tone];
---

<span
  class:list={['label inline-flex items-center gap-1 border border-current px-1.5 py-0.5', classes]}
  data-locale={locale}
  data-tone={tone}
>
  {glyph && (
    <span class="text-[0.6rem]" aria-hidden="true">
      {glyph}
    </span>
  )}
  {locale.toUpperCase()}
  <span class="sr-only">: {LOCALE_TONE_LABELS[tone]}</span>
</span>
