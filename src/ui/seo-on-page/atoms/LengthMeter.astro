---
import { lengthClass } from '../../../core/seo-on-page/pages/inspector/compare';
import { METER_LABELS } from '../labels';

interface Props {
  /** Lo medido (caracteres) y su recomendación: el máximo llena la barra y el mínimo lleva una marca. */
  value: number;
  max: number;
  min: number;
}

const { value, max, min } = Astro.props;
/* `edge` (justo en el mínimo) cumple: solo se avisa por debajo o por encima. */
const length = lengthClass(value, min, max);
const state = length === 'low' ? 'short' : length === 'long' ? 'long' : undefined;
function percent(amount: number) {
  return `${Math.min(100, (amount / max) * 100)}%`;
}
/* «8/60» sin contexto obligaba a recordar el rango: fuera de él se dice en palabras y cambia de color. */
const reading = [
  METER_LABELS.reading(value, max),
  state === 'short' && `${METER_LABELS.short}: ${METER_LABELS.min(min)}`,
  state === 'long' && `${METER_LABELS.long}: ${METER_LABELS.max(max)}`,
]
  .filter(Boolean)
  .join(', ');
---

<span
  class:list={[
    'inline-flex items-center gap-2 font-mono text-xs whitespace-nowrap',
    state ? 'text-state-wip' : 'text-muted',
  ]}
  role="img"
  aria-label={reading}
  data-meter={state ?? 'ok'}
>
  <span class="relative h-1.5 w-[72px] bg-rule" aria-hidden="true">
    <span
      class:list={['absolute inset-y-0 left-0', state ? 'bg-state-wip' : 'bg-accent-line']}
      style={`width:${percent(value)}`}
    ></span>
    <span
      class="absolute -top-[3px] -bottom-[3px] w-0.5 bg-ink opacity-55"
      style={`left:${percent(min)}`}
    ></span>
  </span>
  <span aria-hidden="true">
    {value}/{max}
  </span>
  {state && (
    <span class="font-semibold" aria-hidden="true">
      {METER_LABELS[state]}
    </span>
  )}
</span>
