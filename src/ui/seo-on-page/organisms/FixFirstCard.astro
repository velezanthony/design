---
/* «Qué arreglar primero»: los tipos de problema por prioridad, con su arreglo y las páginas a tocar. */
import type { OverviewModel } from '../../../core/seo-on-page/pages/overview/model';
import Link from '../../atoms/Link.astro';
import CertaintyTag from '../atoms/CertaintyTag.astro';
import SeverityTag from '../atoms/SeverityTag.astro';
import CodeSpans from '../molecules/CodeSpans.astro';
import OverviewCard from '../molecules/OverviewCard.astro';
import { CARD_LABELS, KIND_LABELS, slugLabel } from '../labels';

interface Props {
  priorities: OverviewModel['priorities'];
  footer: OverviewModel['footer'];
}

const { priorities, footer } = Astro.props;
const labels = CARD_LABELS.fix;
---

<OverviewCard id="c-fix" title={labels.title} why={labels.why} wide>
  {priorities.length === 0 ? (
    <p class="text-muted" data-empty>
      {labels.empty}
    </p>
  ) : (
    <ol class="flex flex-col">
      {priorities.map((priority) => (
        <li
          class="flex flex-col gap-1 border-b border-rule py-3 first:pt-0"
          data-kind={priority.kind}
        >
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <Link href={priority.href} variant="value" class="font-semibold">
              {KIND_LABELS[priority.kind]}
            </Link>
            <SeverityTag severity={priority.severity} />
            <span class="text-sm text-muted">
              {labels.affects(priority.pages, priority.percent, priority.locales)}
            </span>
            <CertaintyTag certainty={priority.certainty} />
          </div>
          {priority.fix && (
            <p class="text-sm text-muted" data-fix>
              <CodeSpans text={priority.fix} />
            </p>
          )}
          {priority.affected.length > 0 && (
            <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm" data-affected>
              {priority.affected.map(({ slug, href }) => (
                <li>
                  <Link href={href} class="font-mono">
                    {slugLabel(slug)}
                  </Link>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ol>
  )}
  <p class="flex flex-wrap gap-x-6 gap-y-1 text-sm">
    {footer.problems && (
      <Link href={footer.problems.href}>{labels.problems(footer.problems.pages)}</Link>
    )}
    <Link href={footer.all}>{labels.all}</Link>
  </p>
</OverviewCard>
