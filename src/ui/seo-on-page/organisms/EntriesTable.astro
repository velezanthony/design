---
/* La vista «Por idioma»: una fila por entrada (página + idioma), compacta. El contenedor con scroll
   lleva `tabindex="0"` a propósito, como en `PagesTable`: sin él el teclado no podría desplazarla. */
/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex */
import type { EntryRow } from '../../../core/seo-on-page/pages/listing/entries';
import { THRESHOLDS } from '../../../core/seo-on-page/thresholds';
import Link from '../../atoms/Link.astro';
import IssueBadge from '../atoms/IssueBadge.astro';
import LengthMeter from '../atoms/LengthMeter.astro';
import LocaleBadge from '../atoms/LocaleBadge.astro';
import {
  DESCRIPTION_SOURCE_LABELS,
  ENTRIES_TABLE_LABELS as LABELS,
  PAGES_TABLE_LABELS,
  slugLabel,
} from '../labels';

interface Props {
  /** Una fila por entrada, ya ordenada por gravedad. */
  rows: EntryRow[];
}

const { rows } = Astro.props;
const cell = 'px-3 py-2 align-top';
const edge = 'border-b border-rule';
---

{rows.length === 0 ? (
  <p class="border border-rule bg-raised p-4 text-muted">{PAGES_TABLE_LABELS.empty}</p>
) : (
  <div class="flex flex-col gap-2">
    <p class="text-sm text-muted">{LABELS.recommendation}</p>
    <div class="overflow-x-auto" tabindex="0">
      <table class="table-cards w-full border-collapse text-left text-sm">
        <caption class="sr-only">{LABELS.caption}</caption>
        <thead>
          <tr class="label text-muted">
            <th scope="col" class:list={[cell, edge]}>
              {LABELS.page}
            </th>
            <th scope="col" class:list={[cell, edge]}>
              {LABELS.locale}
            </th>
            <th scope="col" class:list={[cell, edge]}>
              {LABELS.title}
            </th>
            <th scope="col" class:list={[cell, edge]}>
              {LABELS.description}
            </th>
            <th scope="col" class:list={[cell, edge]}>
              {LABELS.issues}
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class={edge} data-entry={`${row.slug}/${row.locale}`} data-card>
              <th scope="row" class:list={[cell, 'font-normal']}>
                <Link href={row.href} class="font-mono">
                  {slugLabel(row.slug)}
                </Link>
                <p class="text-ink">{row.title}</p>
              </th>
              <td class={cell} data-cell={LABELS.locale}>
                <LocaleBadge locale={row.locale} tone={row.tone} />
              </td>
              <td class={cell} data-cell={LABELS.title}>
                <LengthMeter
                  value={row.titleLength}
                  max={THRESHOLDS.titleMax}
                  min={THRESHOLDS.titleMin}
                />
              </td>
              <td class={cell} data-cell={LABELS.description}>
                <p class="text-muted">{DESCRIPTION_SOURCE_LABELS[row.descriptionSource]}</p>
                {row.descriptionLength !== undefined && (
                  <LengthMeter
                    value={row.descriptionLength}
                    max={THRESHOLDS.descriptionMax}
                    min={THRESHOLDS.descriptionMin}
                  />
                )}
              </td>
              <td class={cell} data-cell={LABELS.issues}>
                {row.issues.length === 0 ? (
                  <span class="text-muted">{LABELS.noOwnIssues}</span>
                ) : (
                  <ul class="flex flex-col gap-1.5">
                    {row.issues.map((issue) => (
                      <li>
                        <IssueBadge issue={issue} />
                      </li>
                    ))}
                  </ul>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
)}
