---
import type { InspectorModel } from '../../../core/seo-on-page/pages/inspector/model';
import Heading from '../../atoms/Heading.astro';
import Link from '../../atoms/Link.astro';
import IssueBadge from '../atoms/IssueBadge.astro';
import { INSPECTOR_SECTIONS } from '../labels';

interface Props {
  issues: InspectorModel['issues'];
}

const { issues } = Astro.props;
---

<section aria-labelledby="issues" data-issues class="flex flex-col gap-2">
  <Heading level={2} size="md" id="issues">
    {INSPECTOR_SECTIONS.issues}
  </Heading>
  {issues.length === 0 ? (
    <p class="text-muted">Sin problemas.</p>
  ) : (
    <ul class="flex flex-col gap-2">
      {issues.map(({ issue, related }) => (
        <li class="flex flex-col gap-1">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <IssueBadge issue={issue} />
            <span class="text-ink">{issue.message}</span>
            {related.length > 0 && (
              <span class="text-muted">
                Con:{' '}
                {related.map((other, index) => (
                  <>
                    {index > 0 && ', '}
                    <Link data-related href={other.href} class="font-mono">
                      {other.slug || '/'}
                    </Link>
                  </>
                ))}
              </span>
            )}
          </div>
          {issue.fix && (
            <p data-fix class="text-sm text-muted">
              <span class="label">Arreglo</span> {issue.fix}
            </p>
          )}
        </li>
      ))}
    </ul>
  )}
</section>
