---
import type { InspectorModel } from '../../../core/seo-on-page/pages/inspector/model';
import Link from '../../atoms/Link.astro';
import Tag from '../../atoms/Tag.astro';
import LocaleBadge from '../atoms/LocaleBadge.astro';
import { INSPECTOR_HEADER_LABELS as L, SEVERITY_TONES } from '../labels';

interface Props {
  header: InspectorModel['header'];
  links: InspectorModel['links'];
}

const { header, links } = Astro.props;
const everywhere = header.presentIn.length === header.total;
---

<header data-inspector-header class="flex flex-col gap-4 border-b border-rule pb-6">
  <nav>
    <Link href={links.pages} class="cursor-pointer">
      {L.back}
    </Link>
  </nav>
  <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-4">
    <div class="flex min-w-0 flex-col gap-3">
      <p class="label text-muted">{L.kicker}</p>
      <p class="text-lg text-ink" data-title>
        {header.title}
      </p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        {header.locales.length > 1 && (
          <nav aria-label={L.localeSwitch} class="flex gap-1" data-locale-switch>
            {header.locales.map((item) => {
              const badge = { locale: item.locale, tone: item.tone };
              return item.href ? (
                <a
                  href={item.href}
                  class="cursor-pointer p-0.5 hover:bg-raised focus-visible:outline-2 focus-visible:outline-accent"
                >
                  <LocaleBadge {...badge} />
                </a>
              ) : (
                <span
                  aria-current={item.current ? 'true' : undefined}
                  class:list={['p-0.5', item.current && 'bg-accent-soft']}
                >
                  <LocaleBadge {...badge} />
                </span>
              );
            })}
          </nav>
        )}
        {header.counts.length > 0 && (
          <p class="flex flex-wrap gap-x-3" aria-label={L.counts} data-counts>
            {header.counts.map(({ severity, count }) => (
              <Tag tone={SEVERITY_TONES[severity]} plain data-severity={severity}>
                {L.count(severity, count)}
              </Tag>
            ))}
          </p>
        )}
        <Tag plain bordered tone={header.noindex ? 'wip' : 'live'} data-tag="indexing">
          {header.noindex ? L.noindex : L.indexable}
        </Tag>
        {header.total > 1 && (
          <Tag plain bordered data-tag="coverage">
            {everywhere ? L.inAll(header.total) : L.only(header.presentIn)}
          </Tag>
        )}
      </div>
    </div>
    <div data-inspector-actions class="flex flex-col items-start gap-3 sm:items-end">
      <slot name="actions" />
      <p class="flex flex-wrap gap-x-5 gap-y-1">
        <Link href={links.live} external class="cursor-pointer">
          {L.live} ↗
        </Link>
        {links.edit && (
          <Link href={links.edit} external class="cursor-pointer" data-edit>
            {L.edit} ↗
          </Link>
        )}
      </p>
    </div>
  </div>
</header>
