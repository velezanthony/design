---
/* «Schemas (JSON-LD)»: qué tipos se declaran, a cuántas páginas llegan y cuántas se quedan sin ninguno. */
import type { OverviewModel } from '../../../core/seo-on-page/pages/overview/model';
import Tag from '../../atoms/Tag.astro';
import OverviewCard from '../molecules/OverviewCard.astro';
import StatRow from '../molecules/StatRow.astro';
import { CARD_LABELS } from '../labels';

interface Props {
  schemas: OverviewModel['schemas'];
}

const { schemas } = Astro.props;
const L = CARD_LABELS.schemas;
---

<OverviewCard id="c-sch" title={L.title} why={L.why}>
  <ul>
    {schemas.types.map(({ type, pages, scope }) => (
      <StatRow>
        <Fragment slot="label">
          <span data-schema-type={type}>{type}</span>
          {L.scopes[scope] && (
            <Tag bordered plain data-scope={scope}>
              {L.scopes[scope]}
            </Tag>
          )}
        </Fragment>
        {pages} <small class="text-muted">{L.unit}</small>
      </StatRow>
    ))}
    <StatRow muted>
      <Fragment slot="label">{L.none}</Fragment>
      <span data-without>{schemas.withoutSchemas}</span>
    </StatRow>
  </ul>
</OverviewCard>
