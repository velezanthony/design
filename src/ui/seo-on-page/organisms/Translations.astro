---
import type { InspectorModel } from '../../../core/seo-on-page/pages/inspector/model';
import { worst } from '../../../core/seo-on-page/severity';
import Link from '../../atoms/Link.astro';
import Tag from '../../atoms/Tag.astro';
import LocaleBadge from '../atoms/LocaleBadge.astro';
import {
  COMPARE_LABELS as L,
  DESCRIPTION_SOURCE_LABELS,
  KIND_LABELS,
  SEVERITY_TONES,
} from '../labels';
import InspectorSection from '../molecules/InspectorSection.astro';

interface Props {
  /** La comparación entre idiomas; sin ella (un solo idioma) la sección no se pinta. */
  translations: NonNullable<InspectorModel['translations']>;
}

const { translations } = Astro.props;
const { columns } = translations;

const toneOf = (column: (typeof columns)[number]) =>
  column.state === 'missing'
    ? 'missing'
    : column.state === 'unknown'
      ? 'ok'
      : (worst(column.issues.map((issue) => issue.severity)) ?? 'ok');
const cell = 'border-b border-rule px-3 py-2 align-top';
---

<InspectorSection section="translations">
  <div class="overflow-x-auto">
    <table class="w-full border-collapse text-left text-sm" data-compare>
      <caption class="sr-only">{L.caption}</caption>
      <thead>
        <tr>
          <th scope="col" class={`${cell} label text-muted`}>
            {L.field}
          </th>
          {columns.map((column) => (
            <th scope="col" class={cell} data-col={column.locale}>
              {column.state === 'present' && column.href ? (
                <Link href={column.href} class="cursor-pointer">
                  <LocaleBadge locale={column.locale} tone={toneOf(column)} />
                </Link>
              ) : (
                <LocaleBadge locale={column.locale} tone={toneOf(column)} />
              )}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        <tr data-row="title">
          <th scope="row" class={`${cell} label text-muted`}>
            {L.title}
          </th>
          {columns.map((column) => (
            <td class={`${cell} text-ink`}>
              {column.state === 'present'
                ? column.title
                : column.state === 'missing'
                  ? L.missing(column.policy, column.declared)
                  : L.unknown}
            </td>
          ))}
        </tr>
        <tr data-row="titleLength">
          <th scope="row" class={`${cell} label text-muted`}>
            {L.length}
          </th>
          {columns.map((column) => (
            <td
              class:list={[
                cell,
                'font-mono',
                column.state === 'present' && column.differs.titleLength && 'text-state-wip',
              ]}
              data-differs={
                column.state === 'present' && column.differs.titleLength ? '' : undefined
              }
            >
              {column.state === 'present' ? (
                <>
                  {column.titleLength}
                  {column.differs.titleLength && (
                    <span class="font-sans">
                      {' '}
                      {L.differs} {L.lengthNotes[column.titleClass]}
                    </span>
                  )}
                </>
              ) : (
                L.none
              )}
            </td>
          ))}
        </tr>
        <tr data-row="description">
          <th scope="row" class={`${cell} label text-muted`}>
            {L.description}
          </th>
          {columns.map((column) => (
            <td class={`${cell} text-ink`}>
              {column.state === 'present' ? (column.description ?? L.none) : L.none}
            </td>
          ))}
        </tr>
        <tr data-row="descriptionLength">
          <th scope="row" class={`${cell} label text-muted`}>
            {L.descriptionLength}
          </th>
          {columns.map((column) => (
            <td
              class:list={[
                cell,
                'font-mono',
                column.state === 'present' && column.differs.descriptionLength && 'text-state-wip',
              ]}
              data-differs={
                column.state === 'present' && column.differs.descriptionLength ? '' : undefined
              }
            >
              {column.state === 'present' ? (
                <>
                  {column.descriptionLength ?? L.none}
                  {column.differs.descriptionLength && (
                    <span class="font-sans">
                      {' '}
                      {L.differs} {L.lengthNotes[column.descriptionClass]}
                    </span>
                  )}
                </>
              ) : (
                L.none
              )}
            </td>
          ))}
        </tr>
        <tr data-row="descriptionSource">
          <th scope="row" class={`${cell} label text-muted`}>
            {L.descriptionSource}
          </th>
          {columns.map((column) => (
            <td
              class:list={[
                cell,
                column.state === 'present' && column.differs.descriptionSource
                  ? 'text-state-wip'
                  : 'text-ink',
              ]}
              data-differs={
                column.state === 'present' && column.differs.descriptionSource ? '' : undefined
              }
            >
              {column.state === 'present' ? (
                <>
                  {DESCRIPTION_SOURCE_LABELS[column.descriptionSource]}
                  {column.differs.descriptionSource && <span> · {L.differs}</span>}
                </>
              ) : (
                L.none
              )}
            </td>
          ))}
        </tr>
        <tr data-row="issues">
          <th scope="row" class={`${cell} label text-muted`}>
            {L.issues}
          </th>
          {columns.map((column) => (
            <td class={cell}>
              {column.state === 'present' ? (
                column.issues.length === 0 ? (
                  <span class="text-muted">{L.noIssues}</span>
                ) : (
                  <ul class="flex flex-col items-start gap-1">
                    {column.issues.map((issue) => (
                      <li>
                        <Tag tone={SEVERITY_TONES[issue.severity]} bordered plain>
                          {KIND_LABELS[issue.kind]}
                        </Tag>
                      </li>
                    ))}
                  </ul>
                )
              ) : (
                L.none
              )}
            </td>
          ))}
        </tr>
      </tbody>
    </table>
  </div>
</InspectorSection>
