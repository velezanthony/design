---
import type { OverviewModel } from '../../../core/seo-on-page/pages/overview/model';
import Heading from '../../atoms/Heading.astro';
import Link from '../../atoms/Link.astro';
import Tag from '../../atoms/Tag.astro';
import { KIND_LABELS, SEVERITY_PLURALS, SEVERITY_TONES } from '../labels';

interface Props {
  model: OverviewModel;
}

const { model } = Astro.props;
const { totals, links, schemas } = model;
const stats = [
  { id: 'total', label: 'Páginas (por idioma)', value: totals.total },
  { id: 'with-problems', label: 'Con problemas', value: totals.withProblems },
  { id: 'informative-only', label: 'Solo informativas', value: totals.informativeOnly },
  { id: 'clean', label: 'Sin nada', value: totals.clean },
];
/* La fila entera es el enlace (o, sin incidencias, un texto apagado): una zona de clic amplia. `rowBox` no lleva `display`: el enlace ya es inline-flex y el texto añade flex. */
const rowBox = 'min-h-8 w-full justify-between gap-4 border-b border-rule py-1';
const rowText = `flex items-baseline ${rowBox}`;
---

<div class="flex flex-col gap-8">
  <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {stats.map((stat) => (
      <div class="border border-rule bg-raised p-4" data-stat={stat.id}>
        <dt class="label text-muted">{stat.label}</dt>
        <dd class="mt-1 text-display font-semibold text-ink">{stat.value}</dd>
      </div>
    ))}
  </dl>

  <p class="flex flex-wrap gap-x-6 gap-y-1">
    <Link href={links.problems}>Ver las páginas con problemas</Link>
    <Link href={links.all}>Ver todas las páginas</Link>
  </p>

  <section aria-labelledby="schemas" data-schemas class="max-w-measure">
    <Heading level={2} size="md" id="schemas">
      Schemas (JSON-LD)
    </Heading>
    {schemas.withSchemas === 0 ? (
      <p class="mt-1 text-sm text-muted">Ninguna página declara schemas.</p>
    ) : (
      <>
        <p class="mt-1 text-sm text-muted">
          <span class="font-mono text-ink">{schemas.withSchemas}</span> páginas con schema,{' '}
          <span class="font-mono text-ink">{schemas.withoutSchemas}</span> sin él.
        </p>
        <ul class="mt-3">
          {schemas.types.map(({ type, pages }) => (
            <li data-schema-type={type} class:list={[rowText, 'text-ink']}>
              <span class="font-mono">{type}</span>
              <span class="font-mono">{pages}</span>
            </li>
          ))}
        </ul>
      </>
    )}
  </section>

  <section aria-labelledby="by-severity" class="max-w-measure">
    <Heading level={2} size="md" id="by-severity">
      Por gravedad
    </Heading>
    <p class="mt-1 text-sm text-muted">
      Cuenta incidencias, no páginas: una página puede tener varias.
    </p>
    <ul class="mt-3">
      {model.bySeverity.map(({ severity, count, href }) => (
        <li data-severity={severity}>
          {href ? (
            <Link href={href} class={rowBox}>
              {SEVERITY_PLURALS[severity]}
              <Tag tone={SEVERITY_TONES[severity]} plain class="font-mono">
                {count}
              </Tag>
            </Link>
          ) : (
            <p class={`${rowText} text-muted`}>
              {SEVERITY_PLURALS[severity]}
              <span class="font-mono">0</span>
            </p>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="by-kind" class="max-w-measure">
    <Heading level={2} size="md" id="by-kind">
      Por tipo de problema
    </Heading>
    <ul class="mt-3">
      {model.byKind.map(({ kind, count, href }) => (
        <li data-kind={kind}>
          {href ? (
            <Link href={href} class={rowBox}>
              {KIND_LABELS[kind]}
              <span class="font-mono text-ink">{count}</span>
            </Link>
          ) : (
            <p class={`${rowText} text-muted`}>
              {KIND_LABELS[kind]}
              <span class="font-mono">0</span>
            </p>
          )}
        </li>
      ))}
    </ul>
  </section>
</div>
