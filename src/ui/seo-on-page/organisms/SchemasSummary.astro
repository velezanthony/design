---
import type { OverviewModel } from '../../../core/seo-on-page/pages/overview/model';
import Heading from '../../atoms/Heading.astro';

interface Props {
  schemas: OverviewModel['schemas'];
}

const { schemas } = Astro.props;
const rowText =
  'flex min-h-8 w-full items-baseline justify-between gap-4 border-b border-rule py-1';
---

<section aria-labelledby="schemas" data-schemas class="max-w-measure">
  <Heading level={2} size="md" id="schemas">
    Schemas (JSON-LD)
  </Heading>
  {schemas.withSchemas === 0 ? (
    <p class="mt-1 text-sm text-muted">Ninguna página declara schemas.</p>
  ) : (
    <>
      <p class="mt-1 text-sm text-muted">
        <span class="font-mono text-ink">{schemas.withSchemas}</span> páginas con schema,{' '}
        <span class="font-mono text-ink">{schemas.withoutSchemas}</span> sin él.
      </p>
      <ul class="mt-3">
        {schemas.types.map(({ type, pages }) => (
          <li data-schema-type={type} class:list={[rowText, 'text-ink']}>
            <span class="font-mono">{type}</span>
            <span class="font-mono">{pages}</span>
          </li>
        ))}
      </ul>
    </>
  )}
</section>
