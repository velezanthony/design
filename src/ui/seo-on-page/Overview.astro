---
import { IssueKind, IssueSeverity } from '../../core/seo-on-page/tree/types';
import type { SeoSummary } from '../../core/seo-on-page/queries/summary';
import Heading from '../atoms/Heading.astro';
import { KIND_LABELS, SEVERITY_PLURALS, SEVERITY_TONES } from './labels';

interface Props {
  summary: SeoSummary;
  hrefs: {
    /** La tabla sin filtros. */
    pages: string;
    /** La tabla filtrada por un tipo de problema / por una gravedad. */
    kind: (kind: IssueKind) => string;
    severity: (severity: IssueSeverity) => string;
  };
}

const { summary, hrefs } = Astro.props;
const stats = [
  { id: 'total', label: 'Páginas (por idioma)', value: summary.total },
  { id: 'with-issues', label: 'Con problemas', value: summary.withIssues },
  { id: 'without-issues', label: 'Sin problemas', value: summary.withoutIssues },
];
const row = 'flex min-h-8 w-full items-baseline justify-between gap-4 border-b border-rule py-1';
const link = 'text-accent hover:underline underline-offset-[0.2em]';
const inlineLink = 'text-accent underline underline-offset-[0.2em]';
---

<div class="flex flex-col gap-8">
  <dl class="grid gap-4 sm:grid-cols-3">
    {stats.map((stat) => (
      <div class="border border-rule bg-raised p-4" data-stat={stat.id}>
        <dt class="label text-muted">{stat.label}</dt>
        <dd class="mt-1 text-display font-semibold text-ink">{stat.value}</dd>
      </div>
    ))}
  </dl>

  <p>
    <a href={hrefs.pages} class={inlineLink}>
      Ver todas las páginas
    </a>
  </p>

  <section aria-labelledby="by-severity" class="max-w-measure">
    <Heading level={2} size="md" id="by-severity">
      Por gravedad
    </Heading>
    <p class="mt-1 text-sm text-muted">
      Cuenta incidencias, no páginas: una página puede tener varias.
    </p>
    <ul class="mt-3">
      {Object.values(IssueSeverity).map((severity) => (
        <li data-severity={severity}>
          {summary.bySeverity[severity] > 0 ? (
            <a href={hrefs.severity(severity)} class:list={[row, link]}>
              {SEVERITY_PLURALS[severity]}
              <span class:list={['font-mono', SEVERITY_TONES[severity]]}>
                {summary.bySeverity[severity]}
              </span>
            </a>
          ) : (
            <p class:list={[row, 'text-muted']}>
              {SEVERITY_PLURALS[severity]}
              <span class="font-mono">0</span>
            </p>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="by-kind" class="max-w-measure">
    <Heading level={2} size="md" id="by-kind">
      Por tipo de problema
    </Heading>
    <ul class="mt-3">
      {Object.values(IssueKind).map((kind) => (
        <li data-kind={kind}>
          {summary.byKind[kind] > 0 ? (
            <a href={hrefs.kind(kind)} class:list={[row, link]}>
              {KIND_LABELS[kind]}
              <span class="font-mono text-ink">{summary.byKind[kind]}</span>
            </a>
          ) : (
            <p class:list={[row, 'text-muted']}>
              {KIND_LABELS[kind]}
              <span class="font-mono">0</span>
            </p>
          )}
        </li>
      ))}
    </ul>
  </section>
</div>
