---
/* Pie de la tabla de páginas: una sola barra con «Filas por página» a un lado y, al otro, el
   rango y el paginador (el recuento total, dicho según la vista, va sobre la tabla). El tamaño es un control de la tabla (como el paginador), no un filtro,
   por eso no vive en el formulario de filtros. */
import { PAGE_SIZES } from '../../../core/seo-on-page/queries/paginate';
import {
  filterFields,
  type SeoFilters,
  type ViewState,
} from '../../../core/seo-on-page/queries/url-filters';
import Button from '../../atoms/Button.astro';
import Select from '../../atoms/Select.astro';
import Pagination from '../../molecules/Pagination.astro';
import { PAGINATION_LABELS, rowsUnit, TABLE_FOOTER_LABELS } from '../labels';
import ResultsCount from './ResultsCount.astro';

interface Props {
  /** Filtros ESCRITOS en la URL (no los efectivos): se reenvían tal cual para no cambiar la vista. */
  filters: SeoFilters;
  perPage: number;
  /** La vista en vigor: viaja oculta para que cambiar el tamaño no la deshaga. */
  view: ViewState;
  /** Ruta de la tabla: el selector es un GET a ella. */
  action: string;
  from: number;
  to: number;
  total: number;
  overall: number;
  page: number;
  pages: number;
  href: (page: number) => string;
}

const { filters, perPage, view, action, from, to, total, overall, page, pages, href } = Astro.props;
---

<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
  {/* Un GET propio con los filtros ocultos y sin `page`: cambiar el tamaño vuelve a la página 1. */}
  <form method="get" action={action} class="flex flex-wrap items-center gap-2">
    {filterFields(filters, view).map((field) => (
      <input type="hidden" name={field.name} value={field.value} />
    ))}
    <Select
      id="seo-table-per"
      name="per"
      label={TABLE_FOOTER_LABELS.perPage}
      value={String(perPage)}
      options={PAGE_SIZES.map((size) => ({ value: String(size), label: String(size) }))}
      inline
      data-auto-submit
    />
    {/* Con JavaScript, elegir un tamaño ya envía el formulario (`client/seo-on-page/auto-submit.ts`). */}
    <noscript>
      <Button type="submit" variant="secondary">
        {TABLE_FOOTER_LABELS.apply}
      </Button>
    </noscript>
  </form>
  <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
    <ResultsCount from={from} to={to} total={total} overall={overall} unit={rowsUnit(view.view)} />
    <Pagination page={page} pages={pages} labels={PAGINATION_LABELS} href={href} />
  </div>
</div>
