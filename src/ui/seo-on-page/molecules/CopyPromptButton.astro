---
/* «Copiar prompt» de un problema: lleva el texto en `data-copy-prompt` y el cliente lo copia. Nace
   oculto por lo mismo que `ReportButton`. */
import Button from '../../atoms/Button.astro';
import { REPORT_LABELS as L } from '../labels';

interface Props {
  prompt: string;
}

const { prompt } = Astro.props;
---

<Button
  variant="quiet"
  hidden
  data-copy-prompt={prompt}
  data-copied={L.promptCopied}
  data-failed={L.promptFailed}
>
  <span data-label>{L.prompt}</span>
</Button>
