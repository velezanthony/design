---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'quiet';

interface Props extends Omit<HTMLAttributes<'button'>, 'type' | 'class'> {
  variant?: Variant;
  /** `button` por defecto: dentro de un formulario, un `<button>` sin tipo lo envía. */
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  type = 'button',
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

/* Las tres comparten caja y foco (el global `:focus-visible`): cambia el énfasis, no el tamaño.
   `min-h-8` pasa de sobra los 24px de WCAG 2.5.8. */
const variants: Record<Variant, string> = {
  /* La acción principal: el acento en el texto (AA) y su tinte de fondo. */
  primary: 'border-accent bg-accent-soft text-accent hover:bg-canvas',
  /* Misma presencia que la primaria sin competir con ella: borde y texto en tinta, como los
     botones del aviso de consentimiento. */
  secondary: 'border-ink text-ink hover:border-accent hover:text-accent',
  /* Sin caja hasta que se apunta a ella: para lo accesorio junto a una acción principal. */
  quiet: 'border-transparent text-muted hover:border-rule hover:text-ink',
};

/* Tailwind 4 deja `cursor: default` en los `<button>`: el puntero hay que pedirlo aquí, una vez,
   y no en cada sitio de uso. Deshabilitado no promete clic. */
const state = disabled ? 'cursor-not-allowed opacity-50' : 'cursor-pointer';
---

<button
  type={type}
  disabled={disabled}
  class:list={[
    'label inline-flex min-h-8 items-center justify-center border px-3 transition-colors',
    variants[variant],
    state,
    className,
  ]}
  {...rest}
>
  <slot />
</button>
