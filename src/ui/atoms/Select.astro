---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'select'>, 'class' | 'id' | 'value'> {
  /** Obligatorio: es lo que une la etiqueta con el campo (`for`/`id`). */
  id: string;
  /** Texto de la etiqueta. Un campo sin etiqueta no es accesible. */
  label: string;
  name: string;
  /** Opciones en el orden en que se pintan. */
  options: { value: string; label: string }[];
  /** Valor de la opción seleccionada; sin él, el navegador marca la primera. */
  value?: string;
  /** Deja la etiqueta solo para lectores de pantalla. */
  hideLabel?: boolean;
  /** Etiqueta y campo en la misma fila y al ancho natural, para controles compactos; por defecto la etiqueta va encima. */
  inline?: boolean;
  disabled?: boolean;
  /** Va al contenedor: el ancho lo decide quien coloca el campo; el campo ocupa todo el suyo. */
  class?: string;
}

const {
  id,
  label,
  options,
  value,
  hideLabel = false,
  inline = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props;
---

<div
  data-select
  data-layout={inline ? 'inline' : 'stacked'}
  class:list={[inline ? 'flex items-center gap-2' : 'flex flex-col gap-1', className]}
>
  <label
    for={id}
    class:list={[hideLabel ? 'sr-only' : 'label text-muted', inline && 'whitespace-nowrap']}
  >
    {label}
  </label>
  <select
    id={id}
    disabled={disabled}
    class:list={[
      'min-h-8 border border-rule bg-canvas px-2 text-ink focus-visible:border-accent',
      !inline && 'w-full',
      disabled ? 'cursor-not-allowed opacity-50' : 'cursor-pointer',
    ]}
    {...rest}
  >
    {options.map((option) => (
      <option value={option.value} selected={option.value === value}>
        {option.label}
      </option>
    ))}
  </select>
</div>
