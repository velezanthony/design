---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'input'>, 'type' | 'class'> {
  name: string;
  value: string;
  checked?: boolean;
  disabled?: boolean;
  /** Va a la etiqueta, que es lo que se coloca; el campo va dentro. */
  class?: string;
}

const { checked = false, disabled = false, class: className, ...rest } = Astro.props;

/* El campo va DENTRO de su etiqueta: así asocia sin `id` y pulsar el texto lo marca. Los dos son
   clicables, los dos llevan el puntero (y, deshabilitados, los dos lo quitan). */
const pointer = disabled ? 'cursor-not-allowed opacity-60' : 'cursor-pointer';
---

<label class:list={['inline-flex min-h-6 items-center gap-1.5', pointer, className]}>
  <input
    type="checkbox"
    checked={checked}
    disabled={disabled}
    class:list={['size-4 accent-accent', pointer]}
    {...rest}
  />
  <slot />
</label>
