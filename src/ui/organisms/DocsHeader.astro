---
import type { Locale } from '../../core/i18n/locale';
import { t, type UiStrings } from '../../core/i18n/ui-strings';
import LocaleSwitch from '../molecules/LocaleSwitch.astro';
import ThemeToggle from '../molecules/ThemeToggle.astro';

interface Props {
  /** Nombre del sitio: enlaza a la portada del idioma. */
  siteName: string;
  homeHref: string;
  lang: Locale;
  /** URL de la misma página en cada idioma en que existe (ver `LocaleSwitch`). */
  hrefs: Partial<Record<Locale, string>>;
  strings: UiStrings;
  /** Id del contenedor principal al que salta el enlace de salto. */
  mainId?: string;
  /** Pinta el conmutador de ancho Lectura / Ancho (`layout.toggles`). */
  layoutToggles?: boolean;
  /** Ancho con el que nace el conmutador; `initLayout` lo corrige con lo guardado. */
  layoutWidth?: 'reading' | 'full';
}

const {
  siteName,
  homeHref,
  lang,
  hrefs,
  strings,
  mainId = 'main-content',
  layoutToggles = false,
  layoutWidth = 'reading',
} = Astro.props;
const widths = [
  {
    value: 'reading',
    label: t(strings, 'layout.reading'),
    icon: 'M4.5 2.5h5a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-5a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1Z',
  },
  {
    value: 'full',
    label: t(strings, 'layout.full'),
    icon: 'M2 2.5h10a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1Z',
  },
] as const;
---

{/* Lo primero que alcanza el tabulador: salta la cabecera y la barra lateral. */}
<a
  href={`#${mainId}`}
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-canvas focus:px-4 focus:py-2 focus:text-ink focus:outline focus:outline-2 focus:outline-accent"
>
  {t(strings, 'skipToContent')}
</a>

<header class="docs-header border-b border-rule">
  <div class="docs-container mx-auto flex max-w-(--page-max) flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-4 lg:px-10">
    <a
      href={homeHref}
      class="order-1 inline-flex min-h-6 items-center font-mono text-lg font-semibold tracking-tight text-ink transition-colors hover:text-accent"
    >
      {siteName}
    </a>

    {/* En móvil: nombre e idioma/tema en la primera fila y el buscador a todo el ancho debajo.
        Desde md, todo en una fila como siempre. */}
    <div class="order-3 w-full md:order-2 md:ml-auto md:w-60">
      <slot />
    </div>
    <div class="order-2 flex items-center gap-1 md:order-3">
      {/* Solo desde md: por debajo no hay columnas que liberar y el ancho completo no aporta. */}
      {layoutToggles && (
        <div
          role="group"
          aria-label={t(strings, 'layout.width')}
          class="docs-width-switch mr-2 hidden md:inline-flex"
        >
          {widths.map((width) => (
            <button
              type="button"
              data-layout-width={width.value}
              aria-pressed={layoutWidth === width.value ? 'true' : 'false'}
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d={width.icon} stroke="currentColor" stroke-width="1.4"></path>
              </svg>
              {width.label}
            </button>
          ))}
        </div>
      )}
      <LocaleSwitch lang={lang} hrefs={hrefs} strings={strings} />
      <ThemeToggle strings={strings} />
    </div>
  </div>
</header>
