---
import Link from '../atoms/Link.astro';
import { translate, type UiStrings } from '../../core/i18n/ui-strings';

interface Props {
  /** Contenedor de Tag Manager que se carga si la persona acepta. Lo lee el script. */
  gtmId: string;
  /** Página de privacidad a la que enlaza el aviso. */
  privacyUrl: string;
  strings: UiStrings;
}

const { gtmId, privacyUrl, strings } = Astro.props;

/* Una sola cadena de clases para ambos: rechazar tiene que ser tan fácil y tan visible como aceptar. */
const button =
  'label inline-flex min-h-10 cursor-pointer items-center justify-center border border-ink px-5 text-ink transition-colors hover:border-accent hover:text-accent';
---

{/*
  Oculto hasta que el script no encuentre una elección guardada. Es una región, no un diálogo: no
  atrapa el foco ni bloquea la página, solo pregunta. `initConsent` (client/preferences/consent.ts) lo arranca
  el layout.
*/}
<section
  data-consent-banner
  data-gtm-id={gtmId}
  aria-label={translate(strings, 'consent.label')}
  hidden
  class="consent-banner border-t border-rule bg-canvas"
>
  <div class="mx-auto flex max-w-(--container-page) flex-wrap items-center justify-between gap-x-8 gap-y-4 px-6 py-4 lg:px-10">
    <p class="max-w-measure text-sm text-muted">
      {translate(strings, 'consent.message')}{' '}
      <Link href={privacyUrl}>{translate(strings, 'consent.privacy')}</Link>
    </p>

    <div class="flex gap-3">
      <button type="button" data-consent-accept class={button}>
        {translate(strings, 'consent.accept')}
      </button>
      <button type="button" data-consent-reject class={button}>
        {translate(strings, 'consent.reject')}
      </button>
    </div>
  </div>
</section>

<style is:global>
  .consent-banner {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 50;
    padding-bottom: env(safe-area-inset-bottom);
  }

  /* El script escribe aquí la altura del aviso mientras se muestra, para que el pie quede libre
     en vez de quedar debajo. */
  body {
    padding-bottom: var(--consent-space, 0);
  }
</style>
