---
import Icon from '../atoms/Icon.astro';
import { translate, type UiStrings } from '../../core/i18n/ui-strings';

interface Props {
  strings: UiStrings;
}

const { strings } = Astro.props;
---

{/*
  `href="#top"` no necesita elemento destino ni script: la especificación de HTML manda al inicio
  del documento para ese fragmento.
*/}
<a href="#top" class="back-to-top" aria-label={translate(strings, 'backToTop')}>
  <Icon name="arrow" size={16} />
</a>

<style>
  .back-to-top {
    position: fixed;
    right: max(1.25rem, env(safe-area-inset-right));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 40;

    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;

    /* En móvil tapa contenido con más facilidad: 40px siguen muy por encima del mínimo táctil (24px). */
    @media (max-width: 47.99rem) {
      inline-size: 2.5rem;
      block-size: 2.5rem;
    }

    border: 1px solid var(--color-rule);
    border-radius: 4px;
    background-color: var(--color-canvas);
    color: var(--color-muted);

    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .back-to-top:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .back-to-top :global(svg) {
    transform: rotate(-90deg);
  }

  @supports (animation-timeline: scroll()) {
    .back-to-top {
      opacity: 0;
      visibility: hidden;

      /* Propiedades sueltas: el atajo reinicia la duración a 0s y una animación guiada por el
         scroll con duración cero nunca corre, así que quedaría siempre oculto. */
      animation-name: back-to-top-in;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
      animation-range: 90vh 140vh;
    }
  }

  @keyframes back-to-top-in {
    from {
      opacity: 0;
      visibility: hidden;
    }
    to {
      opacity: 1;
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>
