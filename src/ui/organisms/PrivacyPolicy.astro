---
import type { PrivacySection } from '../../core/privacy/copy';
import type { UiStrings } from '../../core/i18n/ui-strings';
import Heading from '../atoms/Heading.astro';
import Link from '../atoms/Link.astro';

interface Props {
  /** Título de la página (el `<h1>`). */
  title: string;
  /** Etiqueta pequeña sobre el título. */
  eyebrow: string;
  /** «Última actualización». */
  updatedLabel: string;
  /** Fecha ISO para `<time datetime>` y el mismo día ya escrito en el idioma de la página. */
  updated: { iso: string; text: string };
  /** La política ya en un idioma y con el responsable puesto (`privacyCopy`). */
  sections: PrivacySection[];
  strings?: UiStrings;
  lang?: string;
}

const { title, eyebrow, updatedLabel, updated, sections } = Astro.props;

/* Una región que se desplaza ha de poder enfocarse con el teclado, igual que las tablas del
   Markdown (`astro/markdown/tables`). */
const scrollable = { tabindex: '0' };
---

<article class="py-14 lg:py-20">
  <p class="label mb-5 text-faint">{eyebrow}</p>
  <Heading level={1} size="xl">
    {title}
  </Heading>
  <p class="mt-4 text-sm text-faint">
    {updatedLabel}: <time datetime={updated.iso}>{updated.text}</time>
  </p>

  {/* Sin barra lateral, la política toma el ancho de la página (como cabecera y pie) y la tabla de
      cookies cabe sin desplazarse. */}
  <div class="prose mt-10">
    {sections.map((section) => (
      <>
        <h2 id={section.id}>{section.title}</h2>
        {section.blocks.map((block) => {
          if (block.kind === 'text') return <p>{block.text}</p>;
          if (block.kind === 'list') {
            return (
              <ul>
                {block.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            );
          }
          if (block.kind === 'links') {
            return (
              <ul class="list-none! pl-0!">
                {block.items.map((item) => (
                  <li>
                    <Link href={item.href}>{item.label}</Link>
                  </li>
                ))}
              </ul>
            );
          }
          return (
            <div class="table-scroll" {...scrollable}>
              <table>
                <caption class="sr-only">{block.caption}</caption>
                <thead>
                  <tr>
                    {block.head.map((cell) => (
                      <th scope="col">{cell}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {block.rows.map(([name, ...cells]) => (
                    <tr>
                      {/* Texto libre en una celda que por defecto no parte línea ensancharía la tabla. */}
                      <th scope="row" class="min-w-28 align-top whitespace-normal!">
                        {name}
                      </th>
                      {cells.map((cell) => (
                        <td class="min-w-40 align-top">{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          );
        })}
      </>
    ))}
  </div>
</article>
