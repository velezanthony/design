---
import { t, type UiStrings } from '../../core/i18n/ui-strings';

interface Props {
  /** Dónde se edita el archivo (`editHref`). Sin él no se pinta nada. */
  href?: string;
  strings: UiStrings;
}

const { href, strings } = Astro.props;
---

{href && (
  <a
    href={href}
    class="label inline-flex min-h-6 items-center text-muted transition-colors hover:text-ink"
  >
    {t(strings, 'edit.page')}
  </a>
)}
