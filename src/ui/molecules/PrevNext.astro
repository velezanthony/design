---
import { t, type UiStrings } from '../../core/i18n/ui-strings';

interface Link {
  label: string;
  href: string;
}

interface Props {
  prev?: Link;
  next?: Link;
  strings: UiStrings;
}

const { prev, next, strings } = Astro.props;
---

{(prev || next) && (
  <nav
    aria-label={t(strings, 'pagination.label')}
    class="mt-12 flex items-stretch gap-4 border-t border-rule pt-6"
  >
    {prev && (
      <a
        href={prev.href}
        rel="prev"
        class="group flex min-h-6 flex-1 flex-col items-start gap-1 text-left"
      >
        <span class="label text-faint">{t(strings, 'pagination.prev')}</span>
        <span class="text-accent group-hover:underline">{prev.label}</span>
      </a>
    )}
    {next && (
      <a
        href={next.href}
        rel="next"
        class="group ml-auto flex min-h-6 flex-1 flex-col items-end gap-1 text-right"
      >
        <span class="label text-faint">{t(strings, 'pagination.next')}</span>
        <span class="text-accent group-hover:underline">{next.label}</span>
      </a>
    )}
  </nav>
)}
