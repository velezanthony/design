---
import { localeNames, t, type UiStrings } from '../../core/i18n/ui-strings';
import type { Locale } from '../../core/i18n/locale';

interface Props {
  /** Idioma del contenido original que se está leyendo. */
  originalLocale: Locale;
  /** URL de la página original. */
  href: string;
  strings: UiStrings;
}

const { originalLocale, href, strings } = Astro.props;
---

{/* Aviso de una ruta de reserva: el contenido es el del idioma original. */}
<div role="note" class="mb-6 border-l-3 border-state-wip bg-raised px-4 py-3 text-sm text-muted">
  <p>
    {t(strings, 'translation.fallbackNotice')}{' '}
    <a
      href={href}
      hreflang={originalLocale}
      lang={originalLocale}
      class="inline-flex min-h-6 items-center text-accent underline underline-offset-[0.2em]"
    >
      {localeNames[originalLocale] ?? originalLocale}
    </a>
  </p>
</div>
