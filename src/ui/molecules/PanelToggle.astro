---
import { t, type UiStrings } from '../../core/i18n/ui-strings';

interface Props {
  /** `left` es la barra de navegación; `right`, el índice. */
  side: 'left' | 'right';
  /** Id del panel que pliega el botón (`aria-controls`). */
  controls: string;
  /** Estado con el que nace; `initLayout` lo corrige con lo guardado. */
  open: boolean;
  strings: UiStrings;
  /** Texto de la cabecera cuando está abierta, si no es la etiqueta corta del raíl. */
  title?: string;
}

const { side, controls, open, strings, title } = Astro.props;
const nav = side === 'left';
const collapse = t(strings, nav ? 'layout.collapseNav' : 'layout.collapseToc');
const expand = t(strings, nav ? 'layout.expandNav' : 'layout.expandToc');
const rail = t(strings, nav ? 'layout.navRail' : 'layout.tocRail');
---

{/*
  Solo marcado. `initLayout` (client/layout.ts) engancha `[data-layout-toggle]`: cambia
  `<html data-left|data-right>`, `aria-expanded`, el nombre accesible y `inert` del panel. Los
  dos textos viajan en `data-*` porque el cliente no tiene el catálogo. La cabecera y la etiqueta
  del raíl solo existen donde hay columna lateral (desde lg); en móvil manda el «Menú».
*/}
<div class:list={['docs-panel-head', `docs-panel-head-${side}`]}>
  <span class="docs-panel-title label text-faint">{title ?? rail}</span>
  <button
    type="button"
    class="docs-panel-toggle"
    data-layout-toggle={side}
    aria-controls={controls}
    aria-expanded={open ? 'true' : 'false'}
    aria-label={open ? collapse : expand}
    data-collapse-label={collapse}
    data-expand-label={expand}
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d={nav ? 'M10 3 5 8l5 5' : 'M6 3l5 5-5 5'}
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
  </button>
</div>
<span class="docs-rail-label label text-faint" aria-hidden="true">
  {rail}
</span>
