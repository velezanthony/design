---
import { localeNames, t, type UiStrings } from '../../core/i18n/ui-strings';
import type { Locale } from '../../core/i18n/locale';

interface Props {
  /** Idioma de la página actual. */
  lang: Locale;
  /**
   * URL de cada idioma al que se puede ir. Solo van los que existen: sin gemela no hay clave y
   * por tanto no hay enlace. El idioma actual puede faltar (ruta de reserva): se pinta marcado y
   * sin enlace.
   */
  hrefs: Partial<Record<Locale, string>>;
  strings: UiStrings;
  /** Orden en que se listan. Por defecto, el de `hrefs` más el actual si no está. */
  locales?: Locale[];
  class?: string;
}

const { lang, hrefs, strings, locales, class: className } = Astro.props;

const listed = locales ?? [...new Set([...Object.keys(hrefs), lang])];
const name = (locale: Locale) => localeNames[locale] ?? locale;
---

{/* Con un solo idioma no hay nada que elegir. */}
{listed.length > 1 && (
  <nav aria-label={t(strings, 'locale.switch')} class:list={['flex items-center', className]}>
    <ul class="label flex items-center gap-1">
      {listed.map((locale, index) => {
        const href = hrefs[locale];
        const current = locale === lang;
        const classes = [
          'inline-flex min-h-6 items-center rounded px-1 transition-colors',
          current
            ? 'text-ink underline decoration-accent-line decoration-2 underline-offset-4'
            : 'text-ink/80 hover:text-ink hover:underline underline-offset-4',
        ];
        return (
          <li class="flex items-center gap-1">
            {index > 0 && (
              <span class="text-rule" aria-hidden="true">
                /
              </span>
            )}
            {href ? (
              <a
                href={href}
                hreflang={locale}
                lang={locale}
                aria-current={current ? 'true' : undefined}
                class:list={classes}
              >
                <span class="sr-only">{name(locale)}</span>
                <span aria-hidden="true">{locale}</span>
              </a>
            ) : (
              <span lang={locale} aria-current={current ? 'true' : undefined} class:list={classes}>
                <span class="sr-only">{name(locale)}</span>
                <span aria-hidden="true">{locale}</span>
              </span>
            )}
          </li>
        );
      })}
    </ul>
  </nav>
)}
