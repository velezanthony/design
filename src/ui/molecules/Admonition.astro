---
import { t, type UiKey, type UiStrings } from '../../core/i18n/ui-strings';

export type AdmonitionKind = 'note' | 'info' | 'tip' | 'warning' | 'danger' | 'question';

interface Props {
  kind: AdmonitionKind;
  /** Si falta, el nombre del tipo en el idioma de la página. */
  title?: string;
  /** Se pliega: `<details>` cerrado cuyo `<summary>` es el título. */
  collapsed?: boolean;
  strings: UiStrings;
}

const { kind, title, collapsed = false, strings } = Astro.props;
const heading = title ?? t(strings, `admonition.${kind}` satisfies UiKey);
---

{/*
  Mismo marcado que emiten los plugins de Markdown (directivas y alertas de GitHub). Los estilos
  cuelgan de `.admonition[data-kind]` y `.admonition-title` en theme.css.
*/}
{collapsed ? (
  <details class="admonition" data-kind={kind}>
    <summary class="admonition-title">{heading}</summary>
    <slot />
  </details>
) : (
  <aside class="admonition" data-kind={kind} role="note" aria-label={heading}>
    <p class="admonition-title">{heading}</p>
    <slot />
  </aside>
)}
