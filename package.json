{
  "name": "@velezanthony/design",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "playground"
  ],
  "files": [
    "src",
    "!src/pages",
    "!src/testing",
    "!src/**/fixtures",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "exports": {
    "./integration": "./src/astro/integration/index.ts",
    "./loader": "./src/astro/loader/index.ts",
    "./client/*": "./src/client/*.ts",
    "./components/*": "./src/ui/*",
    "./layouts/*": "./src/ui/layouts/*",
    "./routes/*": "./src/astro/routes/*",
    "./theme.css": "./src/ui/styles/theme.css",
    "./theme-colors": "./src/ui/styles/theme-colors.ts"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playground:dev": "npm run dev -w playground",
    "playground:build": "npm run build -w playground",
    "playground:check": "npm run check -w playground"
  },
  "dependencies": {
    "mdast-util-directive": "^3.2.0",
    "mdast-util-to-markdown": "^2.2.3",
    "pagefind": "^1.6.0",
    "satteri": "~0.11.6",
    "shiki": "^4.6.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "~0.4.10",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "astro": "^7.4.12",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "linkedom": "^0.18.15",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@astrojs/markdown-satteri": ">=0.4.10 <0.5",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "tailwindcss": "^4.3.5"
  }
}
