{
  "name": "@velezanthony/design",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "playground",
    "docs"
  ],
  "files": [
    "src",
    "!src/pages",
    "!src/testing",
    "!src/**/fixtures",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "exports": {
    "./integration": "./src/astro/integration/index.ts",
    "./loader": "./src/astro/loader/index.ts",
    "./content": "./src/astro/content/index.ts",
    "./components/*": "./src/components/*",
    "./theme.css": "./src/components/styles/theme.css",
    "./site-theme": "./src/components/styles/site-theme.css",
    "./theme-colors": "./src/components/styles/theme-colors.ts",
    "./code-themes": "./src/components/styles/code-themes.ts",
    "./client/theme": "./src/client/preferences/theme.ts",
    "./client/consent": "./src/client/preferences/consent.ts",
    "./client/storage": "./src/client/preferences/storage.ts",
    "./client/toc": "./src/client/layout/toc.ts",
    "./last-modified": "./src/astro/data/file-last-modified.ts",
    "./head": "./src/core/seo/head.ts",
    "./ui-strings": "./src/core/i18n/ui-strings.ts",
    "./site": "./src/astro/data/site.ts",
    "./seo": "./src/astro/data/page-head.ts",
    "./seo-schema": "./src/core/seo/seo-schema.ts",
    "./fonts": "./src/astro/routes/Fonts.astro"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playground:dev": "npm run dev -w playground",
    "playground:build": "npm run build -w playground",
    "playground:check": "npm run check -w playground",
    "docs:dev": "npm run dev -w docs",
    "docs:build": "npm run build -w docs",
    "docs:check": "npm run check -w docs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "linkedom": "^0.18.15",
    "mdast-util-directive": "^3.2.0",
    "mdast-util-to-markdown": "^2.2.3",
    "mermaid": "^11.17.2",
    "pagefind": "^1.6.0",
    "satteri": "~0.11.6",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "~0.4.10",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "astro": "^7.4.12",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@astrojs/markdown-satteri": ">=0.4.10 <0.5",
    "astro": "^7.4.12"
  }
}
