{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "!**/*.test.ts",
    "!**/*.d.ts",
    "!src/testing/**",
    "!**/fixtures/**",
    "!src/client/layout/sidebar-scroll.ts"
  ],
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.stryker.json",
  "incremental": true,
  "incrementalFile": ".stryker-cache/incremental.json",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "reporters": ["clear-text", "progress", "html", "json"],
  "ignorePatterns": [
    "/*",
    "!/src",
    "!/scripts",
    "!/docs",
    "!/public",
    "!/package.json",
    "!/tsconfig.json",
    "!/tsconfig.stryker.json",
    "!/vitest.config.ts",
    "!/astro.config.mjs",
    "/docs/dist",
    "/docs/.astro"
  ]
}
